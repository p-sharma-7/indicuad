    "paragraph_index": 296,
    "page_start": 62,
    "page_end": 62,
    "char_start": 125652,
    "char_end": 125882,
    "char_count": 230,
    "text": "Notes:\n1.\nThe Stamp Paper should either in the name of the executing Bank or the party on whose\nbehalf the BG has been issued.\n2.\nThe Performance Bank Guarantee shall be executed by any of the Bank from the List of\nBanks enclosed.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC074-0297",
    "doc_id": "DOC-074",
