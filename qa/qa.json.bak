  {
    "qa_id": "IND-Q-02245",
    "doc_id": "DOC-073",
    "category_id": "CAT-014",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Cause\". Details: Can a party terminate this contract for cause, such as breach, default, or insolvency?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC073-CAT014",
    "answers": [
      {
        "text": "The occurrence and continuation of any of the following events, unless any such event\noccurs as a result of a Force Majeure Event, shall constitute a Buying Entity Event\nof Default:",
        "answer_start": 39338,
        "answer_end": 39519,
        "paragraph_id": "PAR-DOC073-0057"
      },
      {
        "text": "the Buying Entity is in breach of any of its material obligations\npursuant to this Agreement, and such material breach is not rectified by the\nBuying Entity within thirty (30) days of receipt of first notice in this regard\ngiven by SECI.",
        "answer_start": 41098,
        "answer_end": 41335,
        "paragraph_id": "PAR-DOC073-0059"
      }
    ],
