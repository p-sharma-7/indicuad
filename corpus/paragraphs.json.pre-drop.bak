    "char_end": 152884,
    "char_count": 127,
    "text": "13.4.3 During the Consultation Period, the Parties shall continue to perform their respective\nobligations under this Agreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC071-0279",
