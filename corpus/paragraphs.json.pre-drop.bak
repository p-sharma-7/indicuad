  },
  {
    "paragraph_id": "PAR-DOC053-0063",
    "doc_id": "DOC-053",
    "paragraph_index": 63,
    "page_start": 13,
    "page_end": 13,
    "char_start": 22379,
    "char_end": 22535,
    "char_count": 156,
    "text": "Provided that no extra overheads and profits shall be payable on the\npart(s) of work assigned to other agency(s) by the contractor as per terms\nof contract.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC053-0064",
    "doc_id": "DOC-053",
    "paragraph_index": 64,
    "page_start": 13,
    "page_end": 13,
    "char_start": 22537,
    "char_end": 22816,
    "char_count": 279,
    "text": "(b) Schedule(s) referred to in these conditions shall mean the relevant\nschedule(s) annexed to the tender documents or the standard Schedule\nof Rates of the government mentioned in Schedule 'F' hereunder, with\nthe amendments thereto issued upto the date of receipt of the tender.",
