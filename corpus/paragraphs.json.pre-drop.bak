    "page_end": 9,
    "char_start": 23260,
    "char_end": 23420,
    "char_count": 160,
    "text": "iii)\nserious loss or damage by fire, or\n\niv)\ncivil commotion, local commotion of workmen, strike or lockout, affecting any of thetrades\nemployed on the work, or",
    "is_boilerplate": false,
    "is_superseded": false
  },
