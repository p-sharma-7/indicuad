    "intent_group_id": "IG-DOC072-CAT014",
    "answers": [
      {
        "text": "The occurrence and/or continuation of any of the following events, unless any such\nevent occurs as a result of a Force Majeure Event or a breach by SECI or Buying\nEntity(ies) of its obligations under this Agreement, shall constitute an SPD Event of\nDefault:",
        "answer_start": 114179,
        "answer_end": 114436,
