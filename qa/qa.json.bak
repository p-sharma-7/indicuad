  },
  {
    "qa_id": "IND-Q-00934",
    "doc_id": "DOC-048",
    "category_id": "CAT-011",
    "question": "Highlight the parts (if any) of this contract related to \"Confidentiality Exceptions\". Details: What are the exceptions to the confidentiality obligation?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC048-CAT011",
    "answers": [
      {
        "text": "Nothing in this Clause 2 shall apply to information: (i) that was previously known by the Employee, as\nestablished by written records of the Employee prior to receipt of such information from the Company;\n(ii) that was lawfully obtained by the Employee from a third party without any obligations of\nconfidentiality to Company; (iii) that was developed by the Employee independent of the Confidential\nInformation; and (iv) information disclosed to the Employee by the Company without confidentiality\nrestrictions.",
