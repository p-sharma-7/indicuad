    "page_end": 261,
    "char_start": 494077,
    "char_end": 494274,
    "char_count": 197,
    "text": "The Authority unconditionally and irrevocably:\n\n(a)\nagrees that the execution, delivery and performance by it of this Agreement\nconstitute commercial acts done and performed for commercial purpose;",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
