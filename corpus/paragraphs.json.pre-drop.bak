    "paragraph_index": 399,
    "page_start": 77,
    "page_end": 77,
    "char_start": 183160,
    "char_end": 183380,
    "char_count": 220,
    "text": "(ii) The Committee referred above shall conduct its proceedings in accordance with the provisions of\nArticle 19 as if it is an arbitration proceeding under that Article, save and except as provided in\nthis Clause 13.1.2;",
    "is_boilerplate": false,
