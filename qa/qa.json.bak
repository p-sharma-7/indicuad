  {
    "qa_id": "IND-Q-02107",
    "doc_id": "DOC-071",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC071-CAT016",
    "answers": [
      {
        "text": "Where any Dispute or differences arises in relation to this agreement of any nature\nwhatsoever including the construction, interpretation or implementation of the\nprovisions of this agreement as well as claim made by any Party for any change\nin or determination of the Tariff or any matter related to Tariff or claims made by\nany Party which partly or wholly relate to any change in the Tariff or\ndetermination of any of such claims could result in change in the Tariff, and\nrelates to any matter agreed to be referred to the Central  Electricity Regulatory\nCommission, shall be submitted to adjudication by the Central Electricity\nRegulatory Commission. Appeal against the decisions of the Central Electricity\nRegulatory Commission shall be made only as per the provisions of the Electricity\nAct, 2003, as amended from time to time.  All other disputes shall be resolved by\narbitration under the Indian Arbitration and Conciliation Act, 1996.",
        "answer_start": 168056,
        "answer_end": 168999,
        "paragraph_id": "PAR-DOC071-0311"
      },
      {
        "text": "Any legal proceedings in respect of any matters, claims or disputes under this\nAgreement shall be under the jurisdiction of appropriate courts in Delhi.",
        "answer_start": 166368,
        "answer_end": 166520,
        "paragraph_id": "PAR-DOC071-0307"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC071-0307",
      "PAR-DOC071-0311"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
