    "char_start": 24407,
    "char_end": 24619,
    "char_count": 212,
    "text": "14.6. Upon termination of this Agreement, Licensee agrees to return at once to IITK,\nwithout copying, all originals and copies of all materials (other than this Agreement)\ncontaining any Confidential Information.",
    "is_boilerplate": false,
    "is_superseded": false
  },
