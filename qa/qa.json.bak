  {
    "qa_id": "IND-Q-01825",
    "doc_id": "DOC-067",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC067-CAT020",
    "answers": [
      {
        "text": "Time is the essence of the CONTRACT. In case the CONTRACTOR fails to complete the WORK within the stipulated period,\nthen, unless such failure is due to Force Majeure as defined in Clause 26 here above or due to EMPLOYER's defaults, the Total\nContract price shall be reduced by ½ % of the total Contract Price per complete week of delay or part thereof subject to a\nmaximum of 5 % of the Total Contract Price, by way of reduction in price for delay and not as penalty. The said amount will be\nrecovered from amount due to the Contractor/ Contractor’s Contract Performance Security payable on demand. The decision\nof the ENGINEER-IN-CHARGE in regard to applicability of Price Reduction Schedule shall be final and binding on the",
        "answer_start": 60666,
        "answer_end": 61393,
        "paragraph_id": "PAR-DOC067-0075"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC067-0075"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
