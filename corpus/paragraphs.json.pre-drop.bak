    "char_start": 80482,
    "char_end": 80605,
    "char_count": 123,
    "text": "AR TICLE-46 EFFECTIVE DATE AND VALIDITY\n\n46.1 CONTRACT shall become effective on signature by either party after the other.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC068-0224",
