    "char_count": 191,
    "text": "(g) impersonate another person;\n(h) contains software viruses or any other computer code, files or\nprograms designed to interrupt, destroy or limit the functionality of\nany computer resource;",
    "is_boilerplate": false,
    "is_superseded": false
  },
