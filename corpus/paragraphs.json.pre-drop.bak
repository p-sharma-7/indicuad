    "doc_id": "DOC-076",
    "paragraph_index": 423,
    "page_start": 80,
    "page_end": 80,
    "char_start": 193301,
    "char_end": 193434,
    "char_count": 133,
    "text": "(iv) The Concessioning Authority shall determine the value of the redundant movable assets\n(“Residual Asset Value”) as the higher of:",
    "is_boilerplate": false,
