    "char_start": 4116,
    "char_end": 4230,
    "char_count": 114,
    "text": "The Company’s current open order book stands at INR 670 crores inclusive of GST (INR 568 crores\nexclusive of GST).",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC031-0000",
