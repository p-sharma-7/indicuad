  {
    "qa_id": "IND-Q-02533",
    "doc_id": "DOC-080",
    "category_id": "CAT-014",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Cause\". Details: Can a party terminate this contract for cause, such as breach, default, or insolvency?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC080-CAT014",
    "answers": [
      {
        "text": "the Contractor is adjudged bankrupt or insolvent, or if a trustee or receiver is\nappointed for the Contractor or for the whole or material part of its assets that\nhas a material bearing on the Project;\n(l)\nthe Contractor has been, or is in the process of being liquidated, dissolved,\nwound-up, amalgamated or reconstituted in a manner that would cause, in the\nreasonable opinion of the Authority, a Material Adverse Effect;\n(m)\na resolution for winding up or insolvency of the Contractor is passed, or any\npetition for winding up or insolvency of the Contractor is admitted by a court\nof competent jurisdiction and a provisional liquidator or receiver or interim\nresolution professional, as the case may be, is appointed and such order has\nnot been set aside within 90 (ninety) days of the date thereof or the\nContractor is ordered to be wound up by court except for the purpose of\namalgamation or reconstruction; provided that, as part of such amalgamation\nor reconstruction, the entire property, assets and undertaking of the\nContractor are transferred to the amalgamated or reconstructed e",
        "answer_start": 281854,
        "answer_end": 282946,
        "paragraph_id": "PAR-DOC080-0274"
      },
      {
        "text": "the Contractor commits a default in complying with any other provision of this\nAgreement if such a default causes a Material Adverse Effect on the Project or\non the Authority.",
        "answer_start": 284056,
        "answer_end": 284231,
        "paragraph_id": "PAR-DOC080-0275"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
