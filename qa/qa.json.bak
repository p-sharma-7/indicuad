  {
    "qa_id": "IND-Q-02545",
    "doc_id": "DOC-080",
    "category_id": "CAT-019",
    "question": "Highlight the parts (if any) of this contract related to \"Cap on Liability\". Details: Is there a cap on liability or a time limit for bringing claims under this contract?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC080-CAT019",
    "answers": [
      {
        "text": "The total liability of one Party to the other Party under and in accordance with the\nprovisions of this Agreement, save and except as provided in Articles 23 and 25, shall\nnot exceed the Contract Price. For the avoidance of doubt, this Clause shall not limit\nthe liability in any case of fraud, deliberate default or reckless misconduct by the\ndefaulting Party.",
        "answer_start": 324790,
        "answer_end": 325151,
        "paragraph_id": "PAR-DOC080-0313"
      },
      {
        "text": "Neither Party shall be liable to the other Party for loss of use of any Works, loss of\nprofit, loss of any contract or for any indirect or consequential loss or damage which\nmay be suffered by the other Party in connection with this Agreement, save and\nexcept as provided under Articles 23 and 25.",
        "answer_start": 324487,
        "answer_end": 324784,
        "paragraph_id": "PAR-DOC080-0313"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
