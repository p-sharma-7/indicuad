    "char_start": 308654,
    "char_end": 308657,
    "char_count": 3,
    "text": "139",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0674",
    "doc_id": "DOC-076",
    "paragraph_index": 674,
    "page_start": 143,
    "page_end": 143,
    "char_start": 308659,
    "char_end": 308869,
    "char_count": 210,
    "text": "APPENDIX 6\nDESIGNS AND DRAWINGS\n(Concessioning Authority to stipulate the Designs and Drawings that the Concessionaire will be\nexpected to submit for review by the Independent Engineer as per the Scope of Work)",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
