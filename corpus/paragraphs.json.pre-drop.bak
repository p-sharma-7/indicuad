    "paragraph_index": 452,
    "page_start": 84,
    "page_end": 84,
    "char_start": 201471,
    "char_end": 201610,
    "char_count": 139,
    "text": "(a) expiry of the period during which the Affected Party is excused from performance of its\nobligations in accordance with Article 14.7; or",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0453",
    "doc_id": "DOC-076",
    "paragraph_index": 453,
