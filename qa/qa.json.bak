  {
    "qa_id": "IND-Q-01897",
    "doc_id": "DOC-068",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC068-CAT020",
    "answers": [
      {
        "text": "In the event of any delay in completion of WORK or part thereof as per agreed\nschedule, due to reasons other than those specifically exempted vide Articles-\n15.7, 32.2 and 40.3 hereof, OWNER/CONSULTANT may deduct from the\nconsiderations due to CONTRACTOR under CONTRACT or otherwise recover\nfrom CONTRACTOR, a sum calculated at half of one percent (0.5%) of the\nContract Price due to CONTRACTOR for the portion of WORK agreed to be\ncarried out by CONTRACTOR till the date on which the delayed item is due to be\ncompleted, for each week of delay, subject to a maximum of seven and a half\n(7.5%) percent of total Contract Price.",
        "answer_start": 63631,
        "answer_end": 64257,
        "paragraph_id": "PAR-DOC068-0178"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC068-0178"
    ],
