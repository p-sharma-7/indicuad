    "char_end": 408087,
    "char_count": 157,
    "text": "A letter from the Authority, under the hand of an officer not below the rank of\nDraft No. DFA/54028\nAttachment:Annexure C- Revised Standard EPC Agreement.pdf",
    "is_boilerplate": false,
