    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC097-0005",
    "doc_id": "DOC-097",
    "paragraph_index": 5,
    "page_start": 1,
    "page_end": 1,
    "char_start": 493,
    "char_end": 615,
    "char_count": 122,
