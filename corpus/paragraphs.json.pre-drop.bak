    "char_end": 96039,
    "char_count": 334,
    "text": "49 LANGUAGE AND MEASURES:\n49.1  All documents pertaining to the CONTRACT including Specifications, Schedules, Notices, Correspondence, operating and\nmaintenance Instructions, DRAWINGS, or any other writing shall be written in English language. The Metric System of\nmeasurement shall be used in the CONTRACT unless otherwise specified.",
    "is_boilerplate": false,
    "is_superseded": false
  },
