    "char_start": 172353,
    "char_end": 172587,
    "char_count": 234,
    "text": "whatsoever, except to the extent that any such suits, proceedings, actions, demands and\nclaims have arisen due to any negligent act or omission, or breach or default of this\nAgreement on the part of the Government Indemnified Persons.",
    "is_boilerplate": false,
    "is_superseded": false
  },
