    "question": "When is a party allowed to disclose confidential information anyway?",
    "question_register": "semi_formal",
    "intent_group_id": "IG-DOC085-CAT011",
    "answers": [
      {
        "text": "a. information already available in the public domain;\nb. information which has been developed independently by the Managed\nManaged Service Provider;\nc. information which has been received from a third party who had the right to\ndisclose the aforesaid information;\nd. Information which has been disclosed to the public pursuant to a court order.",
        "answer_start": 80523,
        "answer_end": 80868,
        "paragraph_id": "PAR-DOC085-0138"
