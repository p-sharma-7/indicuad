    "doc_id": "DOC-085",
    "paragraph_index": 85,
    "page_start": 22,
    "page_end": 22,
    "char_start": 46414,
    "char_end": 46634,
    "char_count": 220,
    "text": "1.11.3. Changes\nUnless expressly dealt with elsewhere in this Agreement, any changes under or to this\nAgreement shall be dealt with in accordance with the Change Control Schedule set out\nin Schedule II of this Agreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
