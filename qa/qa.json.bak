  {
    "qa_id": "IND-Q-01678",
    "doc_id": "DOC-064",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT020",
    "answers": [
      {
        "text": "if the supplier fails to deliver any or all of the\nGoods or fails to perform the services within the time frame(s) incorporated\nin the contract, BRBNMPL shall, without prejudice to other rights and\nremedies available to BRBNMPL under the contract, deduct from the\ncontract price, as liquidated damages, a sum equivalent to the 0.5% percent\n(or any other percentage if prescribed in the SCC) of the delivered price of\nthe delayed goods and / or services for each week of delay or part thereof\nuntil actual delivery or performance, subject to a maximum deduction of the\n10% (or any other percentage if prescribed in the SCC) of the delayed\n‘goods' or ‘services' contract price(s).",
        "answer_start": 69232,
        "answer_end": 69910,
        "paragraph_id": "PAR-DOC064-0168"
      }
    ],
