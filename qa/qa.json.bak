  {
    "qa_id": "IND-Q-02254",
    "doc_id": "DOC-073",
    "category_id": "CAT-017",
    "question": "Highlight the parts (if any) of this contract related to \"Payment Terms & Schedule\". Details: What are the payment amounts, milestones, and due dates?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC073-CAT017",
    "answers": [
      {
        "text": "From the commencement of supply of power by SECI, the Buying Entity shall pay\nto SECI the monthly Tariff Payments, on or before the Due Date, in accordance with\nTariff as specified in Article 1. All Tariff Payments by the Buying Entity shall be in\nIndian Rupees.\nSECI shall issue to the Buying Entity a signed Monthly Bill on the first business day\nof the month prepared based on provisional solar energy of the preceding month\n(except for first month which shall be computed based on designed CUF and\ncapacity of project) and shall also include the following:",
        "answer_start": 13317,
        "answer_end": 13877,
        "paragraph_id": "PAR-DOC073-0025"
      },
      {
        "text": "The Tariff applicable for the sale of Solar Power by SECI to the Buying Entity\nunder this Agreement shall be the Tariff as applicable for payment by SECI to SPD\nunder the terms of the Power Purchase Agreement between SECI and the SPD\n(Individual SPDs tariff as per schedule B) fixed for entire term of agreement at\ndelivery point and in addition thereto a trading margin of Seven (7) paisa/kWh shall\nbe payable by the Buying Entity to SECI which SECI shall be entitled to appropriate\nas its income.",
        "answer_start": 12189,
        "answer_end": 12687,
        "paragraph_id": "PAR-DOC073-0023"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC073-0023",
      "PAR-DOC073-0025"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
