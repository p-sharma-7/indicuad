    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC079-0419",
    "doc_id": "DOC-079",
    "paragraph_index": 419,
    "page_start": 120,
    "page_end": 120,
    "char_start": 241779,
    "char_end": 241817,
    "char_count": 38,
    "text": "Draft for discussion purposes only\n109",
