    "char_count": 2,
    "text": "84",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0336",
    "doc_id": "DOC-086",
    "paragraph_index": 336,
    "page_start": 84,
    "page_end": 84,
    "char_start": 194437,
    "char_end": 194798,
    "char_count": 361,
    "text": "21.7.2 In the event of default in obtaining the certification specified in Clause 21.7.1, the\nConcessionaire shall, within 15 (fifteen) days thereof, submit to the Authority an action plan\nthat sets out the actions proposed to be taken by the Concessionaire for rectifying its\ndeficiencies and obtaining such certification for all facilities at the XXX Ropeway.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0337",
    "doc_id": "DOC-086",
    "paragraph_index": 337,
    "page_start": 84,
    "page_end": 84,
    "char_start": 194800,
    "char_end": 195153,
    "char_count": 353,
    "text": "21.7.3 If the period of default in obtaining the ISO certification under this Clause 21.7 shall exceed a\ncontinuous period of 3 (three) months, the Concessionaire shall thereafter pay Damages to the\nAuthority in an amount equal to [2% (two per cent)] of the total monthly revenue from Fee for\nevery 1 (one) month of default.]\n21.8      Passenger Charter",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0338",
    "doc_id": "DOC-086",
    "paragraph_index": 338,
    "page_start": 84,
    "page_end": 84,
    "char_start": 195155,
    "char_end": 195491,
    "char_count": 336,
    "text": "The Concessionaire shall publish and implement a charter articulating the rights and\nexpectations of Users (the “Passenger Charter”) substantially in the form specified in\nSchedule-U. The Concessionaire shall at all times be accountable and liable to Users in\naccordance with the provisions of the Passenger Charter and Applicable Laws.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0339",
