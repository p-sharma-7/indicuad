    "char_start": 207905,
    "char_end": 208001,
    "char_count": 96,
    "text": "Draft for discussion purposes only\n95\n\nARTICLE 23\nLIABILITY AND INDEMNITY\n23.1\nGeneral indemnity",
    "is_boilerplate": false,
    "is_superseded": false
  },
