    "doc_id": "DOC-076",
    "paragraph_index": 432,
    "page_start": 82,
    "page_end": 82,
    "char_start": 196421,
    "char_end": 196606,
    "char_count": 185,
    "text": "(c) any failure or delay of a Contractor caused by any of the Non-Political Events, for which no\noffsetting compensation is payable to the Concessionaire or on behalf of the Contractor;",
    "is_boilerplate": false,
    "is_superseded": false
