    "char_start": 3625,
    "char_end": 3849,
    "char_count": 224,
    "text": "8. The licensee shall use and occupy the licensed premises for purpose of _________only and in\nno manner cause nuisance, damage, disturbance, annoyance, inconvenience or interference to\nthe occupiers of neighboring premises.",
    "is_boilerplate": false,
    "is_superseded": false
  },
