    "page_end": 33,
    "char_start": 80815,
    "char_end": 80987,
    "char_count": 172,
    "text": "47.2 Except as otherwise specified in CONTRACT, it shall be sufficient in all respects\nif notices are either delivered at or sent by registered post at following addresses;",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
