    "char_end": 15895,
    "char_count": 168,
    "text": "7.5. Except as provided in this Section 8, nothing herein shall be deemed to grant\nany license or rights in any other technology in addition to the Licensed Technology.",
    "is_boilerplate": false,
    "is_superseded": false
  },
