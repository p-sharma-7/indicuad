    "page_end": 1,
    "char_start": 1667,
    "char_end": 1972,
    "char_count": 305,
    "text": "3.\nAll such Confidential Information shared under this Agreement shall be used by the Parties exclusively for\nthe Purpose and neither Party shall disclose or otherwise use the Confidential Information for any other\npurpose or in any other manner without the prior written approval of the Disclosing Party.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC047-0011",
    "doc_id": "DOC-047",
    "paragraph_index": 11,
    "page_start": 1,
    "page_end": 1,
    "char_start": 1974,
    "char_end": 2296,
    "char_count": 322,
    "text": "4.\nThe Confidential Information shared under this Agreement may be disclosed by the Receiving Party to other\nemployees on a need to know basis, with written consent from the Disclosing Party, in connection with the\nPurpose, and who shall protect the Confidential Information in accordance with the terms of this Agreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
