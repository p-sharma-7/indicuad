    "page_end": 15,
    "char_start": 40149,
    "char_end": 40444,
    "char_count": 295,
    "text": "(a) on or before COD, the Adjusted Equity shall be a sum equal to the Equity funded in Indian\nRupees and expended on the Project, revised to the extent of one half of the variation in Price\nIndex occurring between the first day of the month of Date of Award of Concession and the\nReference Date;",
    "is_boilerplate": false,
    "is_superseded": false
  },
