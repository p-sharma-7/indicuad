    "intent_group_id": "IG-DOC071-CAT014",
    "answers": [
      {
        "text": "The occurrence and/or continuation of any of the following events, unless any such\nevent occurs as a result of a Force Majeure Event or a breach by SECI or Buying\nEntity(ies) of its obligations under this Agreement, shall constitute an RPD Event\nof Default:",
        "answer_start": 141897,
        "answer_end": 142154,
        "paragraph_id": "PAR-DOC071-0254"
      },
      {
        "text": "(iv)\nexcept where due to any SECI’s failure to comply with its material obligations, the\nRPD is in breach of any of its material obligations pursuant to this Agreement, and\nsuch material breach is not rectified by the RPD within thirty (30) days of receipt of\nfirst notice in this regard given by SECI.",
        "answer_start": 144331,
        "answer_end": 144633,
        "paragraph_id": "PAR-DOC071-0262"
      }
