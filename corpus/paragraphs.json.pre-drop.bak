    "char_start": 450,
    "char_end": 583,
    "char_count": 133,
    "text": "Scrip Code: 538734\n\nRef: Intimation under regulation 30 of SEBI (Listing Obligations and Disclosure Requirements),\nRegulations, 2015.",
    "is_boilerplate": false,
