    "paragraph_index": 12,
    "page_start": 1,
    "page_end": 1,
    "char_start": 2298,
    "char_end": 2436,
    "char_count": 138,
    "text": "5.\nThe Receiving Party shall protect the Confidential Information in the same manner as it would protect its\nown confidential information.",
    "is_boilerplate": false,
    "is_superseded": false
  },
