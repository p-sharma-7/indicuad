  {
    "qa_id": "IND-Q-01741",
    "doc_id": "DOC-065",
    "category_id": "CAT-015",
    "question": "Highlight the parts (if any) of this contract related to \"Survival Period\". Details: Which obligations survive termination or expiry of this contract, and for how long?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT015",
    "answers": [
      {
        "text": "Notwithstanding the termination of the Contract, the parties shall continue to be bound by\nthe provisions of this Contract that reasonably require some action or forbearance after\nsuch termination.",
