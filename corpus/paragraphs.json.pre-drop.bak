    "doc_id": "DOC-067",
    "paragraph_index": 59,
    "page_start": 14,
    "page_end": 14,
    "char_start": 45695,
    "char_end": 45697,
    "char_count": 2,
    "text": "13",
    "is_boilerplate": true,
