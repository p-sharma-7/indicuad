    "char_start": 52505,
    "char_end": 52669,
    "char_count": 164,
    "text": "For the first year of operation of the Project, the above limits shall be considered for\nthe complete year after the date of commencement of power from the Project.",
    "is_boilerplate": false,
    "is_superseded": false
  },
