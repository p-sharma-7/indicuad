    "page_end": 33,
    "char_start": 85910,
    "char_end": 86204,
    "char_count": 294,
    "text": "b.\nGeneral Public Liability Insurance covering liabilities including contractual\nliability for bodily injury, including death of persons, and liabilities for damage of\nproperty. This insurance must cover all operations of Service Provider required to\nfulfill the provisions under this Contract.",
    "is_boilerplate": false,
    "is_superseded": false
  },
