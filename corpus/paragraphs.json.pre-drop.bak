  },
  {
    "paragraph_id": "PAR-DOC043-0003",
    "doc_id": "DOC-043",
    "paragraph_index": 3,
    "page_start": 1,
    "page_end": 1,
    "char_start": 197,
    "char_end": 847,
    "char_count": 650,
    "text": "Sub.: Intimation regarding receipt of Work Order.\n\nWith regard to the above captioned subject matter, we would like to inform that M/s. Akash Infra-Projects\nLimited has received a work order on today on 30/09/2025 from the Office of the Executive Engineer,\nPanchayat Road and Building Division, District Panchayat Gandhinagar, amounting to Rs.\n37,99,40,688.50/- (Rupees Thirty Seven Crore Ninety Nine Lakh Forty Thousand Six Hundred\nEighty Eight and Paise Fifty Only) for Work of Construction, Widening, Strengthening and Resurfacing of\nvarious important roads as and when required or in Emergency under Gandhinagar District Panchayat\n(Annual Basis).",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC043-0004",
    "doc_id": "DOC-043",
    "paragraph_index": 4,
    "page_start": 1,
