    "page_end": 262,
    "char_start": 495279,
    "char_end": 495500,
    "char_count": 221,
    "text": "9.3\nPriority of agreements\n\nIn the event of any conflict between the Concession Agreement and this Agreement, the\nprovisions contained in the Concession Agreement shall prevail over this Agreement.\n9.4\nAlteration of terms",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
