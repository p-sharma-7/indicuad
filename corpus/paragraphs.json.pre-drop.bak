    "char_start": 267936,
    "char_end": 268031,
    "char_count": 95,
    "text": "[Refer to paragraph 5.9.7 of the Manual and specify the sections, if any, to be\nreconstructed.]",
    "is_boilerplate": false,
    "is_superseded": false
  },
