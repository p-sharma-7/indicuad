    "paragraph_index": 363,
    "page_start": 69,
    "page_end": 69,
    "char_start": 165185,
    "char_end": 165640,
    "char_count": 455,
    "text": "(b) Taxes and Duties\nThe Concessionaire shall during the Concession Period pay in a timely manner all taxes, duties,\nlevies, cess and charges including but not limited to income tax, GST, excise duty and customs\nduty that may be levied, claimed or demanded from time to time by any Government Authority\nincluding any increase therein effected from time to time from any Government Authority, in respect\nof the Project/ the Project Facilities and Services.",
    "is_boilerplate": false,
    "is_superseded": false
  },
