    "page_end": 170,
    "char_start": 359513,
    "char_end": 359599,
    "char_count": 86,
    "text": "(a) all taxes due and payable by the Concessionaire for and in respect of the Project;",
    "is_boilerplate": false,
    "is_superseded": false
  },
