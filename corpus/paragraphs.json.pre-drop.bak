    "char_start": 27143,
    "char_end": 27307,
    "char_count": 164,
    "text": "31.\nDRAWINGS:\n\nThe detailed drawings, specifications if any available with EPI, the same will be made\navailable to the contract or during execution of work at site.",
    "is_boilerplate": false,
    "is_superseded": false
  },
