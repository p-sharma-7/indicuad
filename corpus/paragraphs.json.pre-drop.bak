    "doc_id": "DOC-070",
    "paragraph_index": 57,
    "page_start": 11,
    "page_end": 11,
    "char_start": 21581,
    "char_end": 22080,
    "char_count": 499,
    "text": "19.1. No extra items shall be executed unless and until written instructions are issued by the\nEPIL. Any extra item (including variation in specifications of listed item) executed by the\ncontractor without the permission in writing shall not be payable. In case of extra items,\ncontractor shall furnish detailed breakup of the rate of extra item with supporting documents\nwith detailed cost break up duly signed by Engineer-in-Charge of EPIL, which shall be got\napproved from the Competent Authority",
    "is_boilerplate": false,
    "is_superseded": false
  },
