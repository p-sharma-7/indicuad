    "page_end": 42,
    "char_start": 95554,
    "char_end": 95872,
    "char_count": 318,
    "text": "I. AND WHEREAS the Contractor submitted his bid vide… ................................................ in\naccordance with the procedure mentioned along with the bid documents and represented therein\nthat it fulfills all the requirements and has resources and competence to provide the requisite\nservices to the Client.",
    "is_boilerplate": false,
