    "page_end": 227,
    "char_start": 442180,
    "char_end": 442445,
    "char_count": 265,
    "text": "(a) the firm should have conducted statutory audit of the annual accounts of at least one\nhundred companies registered under the Companies Act, 2013, including any re-enactment\nor amendment thereof, of which at least ten should have been public sector undertakings;",
    "is_boilerplate": false,
    "is_superseded": false
  },
