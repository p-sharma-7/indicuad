    "page_end": 2,
    "char_start": 3851,
    "char_end": 4015,
    "char_count": 164,
    "text": "9. The licensee shall not use the licensed premises for any illegal or immoral purpose or carry\nout any activity or do anything, which constitute breach of any law.",
    "is_boilerplate": false,
    "is_superseded": false
  },
