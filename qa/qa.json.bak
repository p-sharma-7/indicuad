  {
    "qa_id": "IND-Q-02404",
    "doc_id": "DOC-076",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC076-CAT020",
    "answers": [
      {
        "text": "The Parties agree that the liquidated damages\nas provided are a genuine pre-estimate of the damages the Concessioning Authority is likely to\nsuffer and are not by way of a penalty. In case the aggregate delay exceeds 180 (one hundred and\neighty) Days or the aggregate liquidated damages paid and/or payable under this provision\nexceeds the specified limit of 5%  of the Total Project Cost,",
        "answer_start": 123036,
        "answer_end": 123425,
        "paragraph_id": "PAR-DOC076-0250"
      },
      {
        "text": "the Concessioning Authority shall be liable to pay liquidated damages in a sum calculated at the\nrate of 0.1% (zero point one percent) of the Performance Guarantee for each day",
        "answer_start": 88079,
        "answer_end": 88255,
        "paragraph_id": "PAR-DOC076-0172"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC076-0172",
