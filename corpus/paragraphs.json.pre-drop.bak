    "char_start": 360635,
    "char_end": 360839,
    "char_count": 204,
    "text": "(b) 90% of Debt Due excluding subordinated debt;\n(c) all payments of outstanding Licence Fee, Royalties and damages certified by the\nConcessioning Authority as due and payable to it by the Concessionaire;",
    "is_boilerplate": false,
    "is_superseded": false
  },
