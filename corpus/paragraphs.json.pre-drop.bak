    "char_start": 30296,
    "char_end": 30742,
    "char_count": 446,
    "text": "23. Notices\n\nAny notice under any of the provisions of this Agreement shall be deemed given\nwhen deposited in the mail, postage prepaid, registered or certified first class mail\nand addressed to the applicable party at the address stated on the signature page\nhereof, or such other address as such party shall specify for itself by like notice to\nother party.  Each party shall transmit to the other a facsimile copy of each such\nnotice promptly.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC083-0089",
    "doc_id": "DOC-083",
    "paragraph_index": 89,
