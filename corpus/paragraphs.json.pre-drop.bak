  },
  {
    "paragraph_id": "PAR-DOC065-0117",
    "doc_id": "DOC-065",
    "paragraph_index": 117,
    "page_start": 13,
    "page_end": 13,
    "char_start": 26228,
    "char_end": 26320,
    "char_count": 92,
    "text": "another representative acceptable to the EIC.\n\n2.12\nSERVICE PROVIDER’S EMPLOYEES / PERSONNEL",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC065-0118",
