    "char_start": 219890,
    "char_end": 219920,
    "char_count": 30,
    "text": "92\nPart IV\nFinancial Covenants",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC080-0215",
    "doc_id": "DOC-080",
    "paragraph_index": 215,
    "page_start": 114,
    "page_end": 114,
    "char_start": 219922,
