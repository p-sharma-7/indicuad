    "char_end": 8240,
    "char_count": 188,
    "text": "14. That if the partners deem proper and in their interest, they may admit any other person or\npersons as partners on the terms and conditions as may be mutually agreed amongst\nthemselves.",
    "is_boilerplate": false,
    "is_superseded": false
  },
