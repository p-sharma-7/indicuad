    "page_end": 274,
    "char_start": 516962,
    "char_end": 517063,
    "char_count": 101,
    "text": "For corresponding month\nof previous year\nFor preceding month\nFor the month reported upon\nNo. of Users",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0993",
    "doc_id": "DOC-086",
    "paragraph_index": 993,
