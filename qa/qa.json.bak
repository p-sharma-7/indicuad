  {
    "qa_id": "IND-Q-02473",
    "doc_id": "DOC-079",
    "category_id": "CAT-019",
    "question": "Highlight the parts (if any) of this contract related to \"Cap on Liability\". Details: Is there a cap on liability or a time limit for bringing claims under this contract?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC079-CAT019",
    "answers": [
      {
        "text": "The total liability of one Party to the other Party under and in accordance with the\nprovisions of this Agreement, save and except as provided in Articles 21 and 23, shall\nnot exceed the Contract Price. For the avoidance of doubt, this Clause shall not limit\nthe liability in any case of fraud, deliberate default or reckless misconduct by the\ndefaulting Party.",
        "answer_start": 233729,
        "answer_end": 234090,
        "paragraph_id": "PAR-DOC079-0409"
      },
      {
        "text": "Neither Party shall be liable to the other Party for loss of use of any Works, loss of\nprofit, loss of any contract or for any indirect or consequential loss or damage which\nmay be suffered by the other Party in connection with this Agreement.",
        "answer_start": 233477,
        "answer_end": 233720,
        "paragraph_id": "PAR-DOC079-0409"
      }
    ],
