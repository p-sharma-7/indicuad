    "paragraph_index": 46,
    "page_start": 9,
    "page_end": 9,
    "char_start": 18390,
    "char_end": 18658,
    "char_count": 268,
    "text": "15.1.9.\nIn case of any reduction in rate of taxes in future or the project getting exemption\nstatus prior to the last date of Bid submission or afterwards, the contractor shall pass\non the benefit to EPIL immediately, failing which EPIL shall have the right to recover",
    "is_boilerplate": false,
