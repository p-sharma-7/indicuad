  {
    "qa_id": "IND-Q-01675",
    "doc_id": "DOC-064",
    "category_id": "CAT-019",
    "question": "Highlight the parts (if any) of this contract related to \"Cap on Liability\". Details: Is there a cap on liability or a time limit for bringing claims under this contract?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT019",
    "answers": [
      {
        "text": "Except in cases of criminal negligence or wilful\nmisconduct, the aggregate liability of the contractor to the Procuring Entity,\nwhether under the contract, in tort or otherwise, shall not exceed the total\nContract Price, provided that this limitation shall not apply to the cost of\nrepairing or replacing defective equipment, or to any obligation of the\ncontractor to indemnify the Procuring Entity concerning IPR infringement.",
        "answer_start": 72966,
        "answer_end": 73393,
        "paragraph_id": "PAR-DOC064-0183"
      },
      {
        "text": "All claims against BRBNMPL\nshall be legally time-barred after three years calculated from the date when\nthe payment falls due unless the payment claim has been under\ncorrespondence.",
        "answer_start": 65198,
        "answer_end": 65379,
        "paragraph_id": "PAR-DOC064-0157"
      }
    ],
