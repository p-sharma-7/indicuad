    "page_start": 1,
    "page_end": 1,
    "char_start": 171,
    "char_end": 322,
    "char_count": 151,
    "text": "This confidentiality and intellectual property assignment agreement (\"Agreement\") is entered into on [___]\n(“Effective Date”), at [___] by and between:",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC048-0003",
    "doc_id": "DOC-048",
