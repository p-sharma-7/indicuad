    "page_end": 1,
    "char_start": 1124,
    "char_end": 1399,
    "char_count": 275,
    "text": "And whereas, the licensor has sufficient interest, right or title in the licensed premises and to\npermit and allow the licensee to use and occupy the licensed premises as bare licensee in his\npersonal capacity for use by him of the licensed premises for residential purposes.",
    "is_boilerplate": false,
    "is_superseded": false
  },
