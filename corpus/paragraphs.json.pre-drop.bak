    "char_end": 45972,
    "char_count": 270,
    "text": "Page 22 of 50\n1.11. Management Phase\n1.11.1. Governance\nThe review and management process of this Agreement shall be carried out in accordance\nwith the Governance Schedule set out in Schedule I of this Agreement and shall cover all\nthe management aspects of the Project.",
    "is_boilerplate": false,
    "is_superseded": false
  },
