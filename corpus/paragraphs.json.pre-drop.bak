    "char_count": 186,
    "text": "(i) all the aforesaid payments due have been made and/or adequate reserves have been\ncreated in respect thereof to the satisfaction of the Senior Lenders and the Concessioning\nAuthority;",
    "is_boilerplate": false,
    "is_superseded": false
  },
