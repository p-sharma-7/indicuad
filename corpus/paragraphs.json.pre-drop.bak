    "paragraph_index": 27,
    "page_start": 5,
    "page_end": 5,
    "char_start": 5999,
    "char_end": 6255,
    "char_count": 256,
    "text": "\"Fax of Acceptance” means intimation regarding notification of award by the Employer\nto the successful Bidder/Service Provider through a Fax/ Letter  conveying that the\nTender/Bid/Offer has been accepted in accordance with the provisions contained therein.",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
