  },
  {
    "paragraph_id": "PAR-DOC080-0847",
    "doc_id": "DOC-080",
    "paragraph_index": 847,
    "page_start": 307,
    "page_end": 307,
    "char_start": 471450,
    "char_end": 471453,
    "char_count": 3,
    "text": "275",
