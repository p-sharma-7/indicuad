    "char_start": 298412,
    "char_end": 298592,
    "char_count": 180,
    "text": "All the quality reports (i.e. checklists & registers) shall be maintained / submitted by the\ncontractor as per EPI QA-QC manual. Checklists & Registers enclosed in the QA-QC manual",
    "is_boilerplate": false,
    "is_superseded": false
