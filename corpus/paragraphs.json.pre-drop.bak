    "char_end": 5426,
    "char_count": 184,
    "text": "Further, I/We agree that in case of forfeiture of Earnest Money or Performance Guarantee as\naforesaid, I/We shall be debarred for participation in the re-tendering process of the work.",
    "is_boilerplate": false,
    "is_superseded": false
  },
