    "char_start": 177764,
    "char_end": 177852,
    "char_count": 88,
    "text": "may be suffered by the non-defaulting party in each case specified under this\nAgreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC071-0345",
