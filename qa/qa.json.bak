    "qa_id": "IND-Q-01768",
    "doc_id": "DOC-065",
    "category_id": "CAT-025",
    "question": "Highlight the parts (if any) of this contract related to \"Technical Standards Compliance\". Details: Which technical standards or specifications must be complied with?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT025",
    "answers": [
      {
        "text": "In respect of all labour, directly employed in the Service for the performance of\nService Provider's part of this agreement, the Service Provider shall at his own\nexpense arrange for all the safety provisions as per safety codes of C.P.W.D.,\nIndian Standards Institution. The Electricity Act, The Mines Act and such other\nacts as applicable.",
        "answer_start": 103110,
        "answer_end": 103451,
        "paragraph_id": "PAR-DOC065-0337"
      },
      {
        "text": "The materials, design and services shall satisfy the relevant Standards, the Job\nSpecifications contained herein and Codes referred to. Where the job specification\nstipulate requirements in addition to those contained in the standard codes and\nspecifications, these additional requirements shall also be satisfied.",
        "answer_start": 14282,
        "answer_end": 14596,
        "paragraph_id": "PAR-DOC065-0066"
      }
    ],
