    "char_start": 2729,
    "char_end": 2889,
    "char_count": 160,
    "text": "Accepted contract value: ₹17,70,07,366.74\n(Rupees Seventeen Crore, Seventy Lakh, Seven\nThousand, three hundred Sixty-Six Rupees and\nSeventy-Four Paise) with GST",
    "is_boilerplate": false,
