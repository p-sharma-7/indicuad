    "page_end": 1,
    "char_start": 1537,
    "char_end": 1665,
    "char_count": 128,
    "text": "2.\nConfidential Information shall include any financial, business, proprietary or technical information of the\nDisclosing Party.",
    "is_boilerplate": false,
    "is_superseded": false
  },
