    "char_end": 100850,
    "char_count": 245,
    "text": "The Contractor shall, at least 15 (fifteen) days prior to the commencement of\nconstruction, submit to the Authority’s Engineer for review the methodology proposed\nto be adopted for executing the Works, giving details of equipment to be deployed,",
    "is_boilerplate": false,
    "is_superseded": false
  },
