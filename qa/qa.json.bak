  {
    "qa_id": "IND-Q-01969",
    "doc_id": "DOC-069",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC069-CAT020",
    "answers": [
      {
        "text": "If the contractor fails to maintain the required progress in terms of clause 5 or to complete the\nwork and clear the site on or before the contract or extended date of completion, he shall,\nwithout prejudice to any other right or remedy available under the law to the Government on\naccount of such breach, pay as agreed compensation, the amount calculated as stipulated\nbelow for every completed day/ month (as applicable) that the progress remains below that\nspecified in Clause 5 or that the work remains incomplete. This will also apply to items or\ngroup of items for which a separate period of completion has been specified.\nCompensation for delay of work\n@ 1.5% per month of delay to be computed\non per day basis, on value of the incomplete\nwork.\nProvided always that the total amount of compensation for delay to be paid under this\nCondition shall not exceed 10% of the total tendered value of work or of the tendered value\nof the item or group of items of work for which a separate period of completion is originally\ngiven.",
        "answer_start": 7481,
        "answer_end": 8511,
        "paragraph_id": "PAR-DOC069-0033"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC069-0033"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
