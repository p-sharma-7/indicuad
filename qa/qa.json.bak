  {
    "qa_id": "IND-Q-02180",
    "doc_id": "DOC-072",
    "category_id": "CAT-016",
    "question": "What happens if the parties end up in a dispute?",
    "question_register": "semi_formal",
    "intent_group_id": "IG-DOC072-CAT016",
