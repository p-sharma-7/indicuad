    "paragraph_index": 325,
    "page_start": 67,
    "page_end": 67,
    "char_start": 134668,
    "char_end": 134833,
    "char_count": 165,
    "text": "v) If generation at any time exceeds the maximum permissible AC capacity at delivery point,\nthe excess generation during that period may not be considered under PPA.",
    "is_boilerplate": false,
    "is_superseded": false
  },
