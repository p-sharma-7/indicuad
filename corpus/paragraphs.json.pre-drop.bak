    "paragraph_index": 385,
    "page_start": 73,
    "page_end": 73,
    "char_start": 177111,
    "char_end": 177249,
    "char_count": 138,
    "text": "28 This period could vary depending on the Project/Concession so as to ensure adequate time for both the survey and restoration of assets.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
