    "char_count": 84,
    "text": "ARTICLE-47 NOTICES & ADDRESSES\n\n47.1 All notices under CONTRACT shall be in writing.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC068-0226",
