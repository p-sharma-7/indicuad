    "paragraph_index": 118,
    "page_start": 13,
    "page_end": 13,
    "char_start": 26322,
    "char_end": 26430,
    "char_count": 108,
    "text": "The Service Provider in connection with performing the Services and remedying of any\ndefects, shall provide:",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC065-0119",
