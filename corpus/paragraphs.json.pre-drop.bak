    "doc_id": "DOC-070",
    "paragraph_index": 70,
    "page_start": 13,
    "page_end": 13,
    "char_start": 25871,
    "char_end": 26190,
    "char_count": 319,
    "text": "Page 13 of 28\n\n29.\nCOMPLETION AND TAKING OVER\n\nAs soon as the project is completed including extended period if any, EPI/ESIC shall\nnominate their Officers for checking /Verification of completed work as per the scope of\nwork and terms and conditions and compliance of statutory compliances etc., for\nfinancial closure.",
    "is_boilerplate": false,
    "is_superseded": false
  },
