  {
    "paragraph_id": "PAR-DOC080-0258",
    "doc_id": "DOC-080",
    "paragraph_index": 258,
    "page_start": 140,
    "page_end": 140,
    "char_start": 263560,
    "char_end": 263637,
    "char_count": 77,
