    "char_start": 83413,
    "char_end": 83597,
    "char_count": 184,
    "text": "ii.\nThe BIDDER shall adhere to the Programme of Work as per Bar Chart attached.\n\niii.\nThe priorities of execution shall be as fixed by the Engineer–in– Charge at the\ntime of execution.",
    "is_boilerplate": false,
    "is_superseded": false
  },
