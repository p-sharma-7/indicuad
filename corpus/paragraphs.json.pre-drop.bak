    "page_end": 171,
    "char_start": 360932,
    "char_end": 361023,
    "char_count": 91,
    "text": "(e) outstanding subordinated debt\n(f) incurred or accrued operation & maintenance expenses;",
    "is_boilerplate": false,
    "is_superseded": false
  },
