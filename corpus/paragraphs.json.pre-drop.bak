    "doc_id": "DOC-083",
    "paragraph_index": 50,
    "page_start": 7,
    "page_end": 7,
    "char_start": 13132,
    "char_end": 13472,
    "char_count": 340,
    "text": "6.6. Within ______ days after the end of Licensee's fiscal year, Licensee shall\nprovide IITK with Licensee's financial statements for the preceding fiscal year\nincluding, at a minimum, an income statement, a statement of cash flows and a\nbalance sheet that has been certified by Licensee's chief financial officer or an\nindependent auditor.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC083-0051",
