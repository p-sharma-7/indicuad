  {
    "qa_id": "IND-Q-01960",
    "doc_id": "DOC-069",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC069-CAT016",
    "answers": [
      {
        "text": "If any dispute or differences of any kind whatsoever were to arise between theEngineer-in-\ncharge, Engineering Section and the Contractor regarding the following matters namely.\ni)\nThe meaning of the specifications, designs, drawings and instructions hereinbefore\nmentioned.\nii)\nThe quality of workmanship or materials used on the work and\niii) Any other question, claim, right, matters, thing whatsoever in any way arising outof or\nrelating to the contract, designs, drawings, specifications, estimates,instructions or orders,\nor those conditions or failure to execute the same whetherarising during the progress of the\nwork after the completion, termination orabandonment thereof, the dispute shall, in the first\nplace be referred to the Executive Engineer/ Director, NIT Meghalaya who has Jurisdiction\nover the work specified in thecontract with the details of claims, justification for the same\nwith supportingdocuments such as analysis of rates, cash vouchers and other relevant\nparticulars.The Executive Engineer/ Director, NIT Meghalaya shall within a period of sixty\ndays from thedate of being requested by the Contractor to do so or from the date of\nfurnishing ofrequired particulars whichever is later shall give written notice of his decision to\nthecontractor.",
        "answer_start": 97445,
        "answer_end": 98716,
        "paragraph_id": "PAR-DOC069-0198"
      },
      {
        "text": "such dispute ordifference shall be\nreferred by either party to the arbitration of one of arbitrators in theDepartment of Public Enterprises\nto be nominated by the Secretary to the Government ofIndia, in charge of the Bureau of Public\nEnterprises. The arbitration Act, 1940 shall not beapplicable to the arbitration under this clause.",
        "answer_start": 101755,
        "answer_end": 102088,
        "paragraph_id": "PAR-DOC069-0207"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC069-0198",
      "PAR-DOC069-0207"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
