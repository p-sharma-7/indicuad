    "char_start": 360056,
    "char_end": 360159,
    "char_count": 103,
    "text": "(f) towards payment ofother sums payable to the Concessioning Authority and liquidated\ndamages, if any;",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0790",
    "doc_id": "DOC-076",
    "paragraph_index": 790,
    "page_start": 171,
    "page_end": 171,
    "char_start": 360160,
    "char_end": 360240,
    "char_count": 80,
    "text": "(g) towards any reserve requirements in accordance with the Financing Documents;",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
