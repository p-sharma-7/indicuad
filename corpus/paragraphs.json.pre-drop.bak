    "char_start": 8332,
    "char_end": 8514,
    "char_count": 182,
    "text": "General Conditions of Contract - Services\n------------------------------------------------------------------------------------------------------------------------------------------\n6",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
