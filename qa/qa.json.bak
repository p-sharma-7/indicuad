    "qa_id": "IND-Q-01681",
    "doc_id": "DOC-064",
    "category_id": "CAT-021",
    "question": "Highlight the parts (if any) of this contract related to \"Insurance\". Details: Is either party required to maintain insurance?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT021",
    "answers": [
      {
        "text": "Unless otherwise instructed in the SCC, the supplier shall make arrangements\nfor insuring the goods against loss or damage incidental to manufacture or\nacquisition, transportation, storage and delivery in the following manner:",
        "answer_start": 38704,
        "answer_end": 38930,
        "paragraph_id": "PAR-DOC064-0096"
      },
      {
        "text": "The transit risk in this respect shall be\ncovered by the Supplier by getting the stores duly insured. The insurance\ncover shall be obtained by the Supplier in its own name and not in the name\nof BRBNMPL or its Consignee.",
        "answer_start": 39118,
        "answer_end": 39338,
        "paragraph_id": "PAR-DOC064-0097"
      }
