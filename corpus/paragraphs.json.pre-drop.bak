    "page_end": 83,
    "char_start": 198569,
    "char_end": 198790,
    "char_count": 221,
    "text": "(a) an act of war (whether declared or undeclared), invasion, armed conflict or act of foreign\nenemy, blockade, embargo, riot, insurrection, terrorist or military action, civil commotion or\npolitically motivated sabotage;",
    "is_boilerplate": false,
