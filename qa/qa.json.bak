  {
    "qa_id": "IND-Q-01660",
    "doc_id": "DOC-064",
    "category_id": "CAT-013",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Convenience\". Details: Can a party terminate this contract for convenience, without cause?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT013",
    "answers": [
      {
        "text": "BRBNMPL reserves the right to terminate the contract, in whole or in part\nfor its (BRBNMPL's) convenience, by serving written notice on the supplier\nat any time during the currency of the contract. The notice shall specify that\nthe termination is for the convenience of BRBNMPL. The notice shall also\nindicate inter-alia, the extent to which the supplier's performance under the\ncontract is terminated, and the date with effect from which such termination\nwill become effective.",
        "answer_start": 78909,
        "answer_end": 79387,
        "paragraph_id": "PAR-DOC064-0195"
