    "char_start": 45313,
    "char_end": 45445,
    "char_count": 132,
    "text": "Sign of Tenderer with seal\n7.\nAssist in carbolization /\nFumigation\nWhen required\nBacillocid\n8.\nScrubbing of floor/ Walls\nOnce a week",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC088-0149",
    "doc_id": "DOC-088",
