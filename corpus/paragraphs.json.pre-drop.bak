    "doc_id": "DOC-072",
    "paragraph_index": 15,
    "page_start": 3,
    "page_end": 3,
    "char_start": 3726,
    "char_end": 4221,
    "char_count": 495,
    "text": "F. SECI has issued the Letter of Award No…………….. dated…………in favour of\nthe ………………[Insert the name of Bidding Company] for development and\nestablishment of the ……………MW Solar Power Project in the State of\n…………….as per the terms and conditions contained in the RfS, and draft of this\nPower Purchase Agreement, including amendments and clarifications thereto\ncirculated at the time of the bidding and other bidding documents as well as the\nconditions contained in the aforementioned Letter of Award.",
    "is_boilerplate": false,
    "is_superseded": false
  },
