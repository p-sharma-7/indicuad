    "char_end": 11864,
    "char_count": 271,
    "text": "13. Entire agreement\n\nThis Agreement sets forth the entire agreement of the parties with respect to the subject matter hereof, and\nsupersedes all prior oral and written agreements, understandings, representations, conditions and all other\ncommunications relating thereto.",
    "is_boilerplate": false,
    "is_superseded": false
  },
