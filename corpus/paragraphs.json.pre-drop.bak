    "page_end": 42,
    "char_start": 56818,
    "char_end": 57035,
    "char_count": 217,
    "text": "Contractor shall hand over all information in relation to the Highway, including but\nnot limited to any data, designs, drawings, structures, information, plans, etc.\nprepared by them for the Highway, to the Authority.",
    "is_boilerplate": false,
