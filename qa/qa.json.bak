  {
    "qa_id": "IND-Q-02557",
    "doc_id": "DOC-080",
    "category_id": "CAT-023",
    "question": "Highlight the parts (if any) of this contract related to \"Delivery & Milestone Obligations\". Details: What are the delivery dates, milestones, or completion schedules?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC080-CAT023",
    "answers": [
      {
        "text": "The Contractor shall construct the Project Highway in accordance with the Project\nCompletion Schedule set forth in Schedule-J. In the event that the Contractor fails to\nachieve any Project Milestone or the Scheduled Completion Date within a period of 30\n(thirty) days from the date set forth in Schedule-J,",
        "answer_start": 136197,
        "answer_end": 136503,
        "paragraph_id": "PAR-DOC080-0148"
      },
      {
        "text": "Within 90 (ninety) days of the Project Completion Date, the Contractor shall furnish\nto the Authority and the Authority’s Engineer a complete set of as- built Drawings, in\n2 (two) hard copies and in micro film form or in such other medium as may be\nacceptable to the Authority, reflecting the Project Highway as actually designed,\nengineered and constructed, including an as-built survey illustrating the layout of the\nProject Highway and setback lines, if any, of the buildings and structures forming part\nof Project Facilities.",
        "answer_start": 134959,
        "answer_end": 135488,
        "paragraph_id": "PAR-DOC080-0147"
      }
    ],
