    "char_end": 235570,
    "char_count": 179,
    "text": "Concessionaire under and in accordance with all other provisions of this\nAgreement, save and except the provisions relating to Termination.\n31.3    Minimum Fee for the XXX Ropeway",
    "is_boilerplate": false,
