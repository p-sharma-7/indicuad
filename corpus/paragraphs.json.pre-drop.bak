    "page_end": 262,
    "char_start": 496621,
    "char_end": 496789,
    "char_count": 168,
    "text": "This Agreement is solely for the benefit of the Parties and no other person or entity shall\nhave any rights hereunder.\n9.7\nSurvival\n9.7.1\nTermination of this Agreement:",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
