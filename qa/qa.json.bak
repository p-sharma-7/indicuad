  {
    "qa_id": "IND-Q-00315",
    "doc_id": "DOC-020",
    "category_id": "CAT-014",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Cause\". Details: Can a party terminate this contract for cause, such as breach, default, or insolvency?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC020-CAT014",
    "answers": [
      {
        "text": "If the PMC fails to provide, maintain or renew the Performance Bank Guarantee in\naccordance with the contract then the Employer may, without prejudice to any other\nrights and remedies to which it may be entitled, by written notice, terminate the\ncontract forthwith.",
        "answer_start": 2630,
        "answer_end": 2895,
        "paragraph_id": "PAR-DOC020-0007"
      },
      {
        "text": "In the event the Performance Bank Guarantee is invoked either partially or fully, the\nsame shall be recouped by the PMC promptly, within 7 (seven) days of such invocation,\nfailing to which, the contract shall stand terminated.",
        "answer_start": 2900,
        "answer_end": 3126,
        "paragraph_id": "PAR-DOC020-0008"
      }
    ],
    "is_impossible": false,
