    "page_end": 123,
    "char_start": 277922,
    "char_end": 278213,
    "char_count": 291,
    "text": "the Debt Due upon termination of the Concession Agreement.\nARTICLE 6\nDURATION OF THE AGREEMENT\n6.1\nDuration of the Agreement\n6.1.1 This Agreement shall come into force from the date hereof and shall expire at the earliest\nto occur of the following events:\na) termination of the Agreement; or",
    "is_boilerplate": false,
    "is_superseded": false
  },
