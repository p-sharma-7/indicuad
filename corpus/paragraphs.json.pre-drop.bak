  {
    "paragraph_id": "PAR-DOC043-0012",
    "doc_id": "DOC-043",
    "paragraph_index": 12,
    "page_start": 3,
    "page_end": 3,
    "char_start": 4191,
    "char_end": 4381,
    "char_count": 190,
    "text": "-\nr\nINWARO to\nask\nDATE\n..\nSign.\nII.\nln\nAUDH\nI\n:\nn\nHER\nPLAN!\na\n1NlCAl 5lLL\n.. .\nI\n3°L5!.e°{\nwvewvrmv\n'\"-\"' I\"~mlec~ euemsen\n\\,.(ccolw°\n'\nNA~CE\nRPGOU0.H.PA!FUA,P,GOu¥.h.PATjf\n~/\n/\nA\nI\n,K\n1\nI\nI",
    "is_boilerplate": false,
