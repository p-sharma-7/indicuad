    "char_count": 68,
    "text": "SECTION – I    DEFINITIONS & INTERPRETATIONS\n1.1\nDefinition of Terms",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC065-0016",
