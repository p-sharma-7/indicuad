    "char_start": 348661,
    "char_end": 348769,
    "char_count": 108,
    "text": "APPENDIX 15\nESCROW AGREEMENT\nTHIS ESCROW AGREEMENT is entered into on this the [●] day of [●] 20[●].\nAMONGST",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
