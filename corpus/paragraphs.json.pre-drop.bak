    "doc_id": "DOC-070",
    "paragraph_index": 45,
    "page_start": 9,
    "page_end": 9,
    "char_start": 18078,
    "char_end": 18388,
    "char_count": 310,
    "text": "15.1.8.\nThe contractor shall keep necessary books of accounts and other documents for\nthe purpose of this condition as may be necessary and shall allow inspection of the\nsame by a duly authorized representative of EPI and shall also furnish such other\ninformation/document as EPI may require from time to time.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
