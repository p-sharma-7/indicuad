  {
    "qa_id": "IND-Q-01908",
    "doc_id": "DOC-068",
    "category_id": "CAT-023",
    "question": "when does the stuff have to be done by",
    "question_register": "naive_layperson",
    "intent_group_id": "IG-DOC068-CAT023",
    "answers": [
      {
        "text": "CONTRACTOR shall carry out work in a phased manner and hand over the\nrespective items to OWNER/CONSULTANT after carrying out such tests as\nare prescribed herein within the programme given in SCHEDULE-B,\nPROGRAMME OF WORK. The responsibilities of CONTRACTOR in\nrespect of programme vide SCHEDULE-B will be effective from the date on\nwhich Letter of Intent has been issued by OWNER/CONSULTANT and\nindicated as 'ZERO DATE' in the said SCHEDULE–B",
        "answer_start": 7296,
        "answer_end": 7738,
        "paragraph_id": "PAR-DOC068-0034"
      },
      {
        "text": "As soon as WORK has been completed in all respects in accordance with\nCONTRACT and has passed the prescribed tests, OWNER/CONSULTANT shall\nissue a certificate taking over the WORK (hereinafter referred to as Taking Over\nCertificate), stating the date on which WORK has been so completed and passed\nthe\ntests,\nand\nthe\nWORK\nshall\nbe\ndeemed\ntaken\nover\nby\nOWNER/CONSULTANT on the said date.",
        "answer_start": 46921,
        "answer_end": 47307,
        "paragraph_id": "PAR-DOC068-0135"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC068-0034",
