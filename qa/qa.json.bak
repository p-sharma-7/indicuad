  {
    "qa_id": "IND-Q-02554",
    "doc_id": "DOC-080",
    "category_id": "CAT-022",
    "question": "Highlight the parts (if any) of this contract related to \"Warranty Duration\". Details: What is the duration of any warranty against defects or errors in goods or services provided?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC080-CAT022",
    "answers": [
      {
        "text": "The Contractor shall be responsible for all the Defects and deficiencies, except usual\nwear and tear in the Project Highway or any Section thereof, till the expiry of a period\nof commencing from the date of Completion Certificate (the “Defects Liability\nPeriod”) as specified below:\n(a)\n5 (five) years from the date of completion in case of a road being constructed\nwith flexible pavement;\n(b)\n10 (ten) years from the date of completion in case of road being constructed\nwith rigid pavement;\n(c)\n10 (ten) years from the date of completion in case of road being constructed\nwith flexible pavement using perpetual design;\n(d)\n10 (ten) years from the date of completion in case of all stand-alone\nstructures, e.g. Major Bridges/ and Tunnels;\n(e)\n10 (ten) years from the date of completion for the stretches where new\ntechnology/ material has been/ is proposed to be used.\n(f)\n3 (three) years from the date of completion for stretches requiring renewal of\nBituminous Concrete (BC) layer through either using hot-in-place recycling of\nthe entire BC layer or providing a fresh layer of BC with 40mm thickness.",
        "answer_start": 207830,
        "answer_end": 208933,
        "paragraph_id": "PAR-DOC080-0205"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC080-0205"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
  {
    "qa_id": "IND-Q-02555",
    "doc_id": "DOC-080",
    "category_id": "CAT-022",
    "question": "How long is the warranty period under this contract?",
    "question_register": "semi_formal",
    "intent_group_id": "IG-DOC080-CAT022",
    "answers": [
      {
        "text": "The Contractor shall be responsible for all the Defects and deficiencies, except usual\nwear and tear in the Project Highway or any Section thereof, till the expiry of a period\nof commencing from the date of Completion Certificate (the “Defects Liability\nPeriod”) as specified below:\n(a)\n5 (five) years from the date of completion in case of a road being constructed\nwith flexible pavement;\n(b)\n10 (ten) years from the date of completion in case of road being constructed\nwith rigid pavement;\n(c)\n10 (ten) years from the date of completion in case of road being constructed\nwith flexible pavement using perpetual design;\n(d)\n10 (ten) years from the date of completion in case of all stand-alone\nstructures, e.g. Major Bridges/ and Tunnels;\n(e)\n10 (ten) years from the date of completion for the stretches where new\ntechnology/ material has been/ is proposed to be used.\n(f)\n3 (three) years from the date of completion for stretches requiring renewal of\nBituminous Concrete (BC) layer through either using hot-in-place recycling of\nthe entire BC layer or providing a fresh layer of BC with 40mm thickness.",
        "answer_start": 207830,
        "answer_end": 208933,
        "paragraph_id": "PAR-DOC080-0205"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC080-0205"
    ],
