    "char_start": 261711,
    "char_end": 261969,
    "char_count": 258,
    "text": "may, without prejudice to his any other rights or remedy against the contract in respect\nof any delay, inferior workmanship, any claims for damages and / or any other provisions\nof this contract or otherwise, and whether the date of completion has or has not",
    "is_boilerplate": false,
    "is_superseded": false
  },
