    "char_start": 83043,
    "char_end": 83192,
    "char_count": 149,
    "text": "Name of Work: Fabrication & supply of 1 no. self-propelled barge (excluding fabrication of bullets)\nfor transportation of Liquefied ammonia gas (LAG)",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC068-0241",
    "doc_id": "DOC-068",
    "paragraph_index": 241,
    "page_start": 35,
    "page_end": 35,
    "char_start": 83194,
    "char_end": 83411,
    "char_count": 217,
    "text": "i.\nThe delivery of the barge shall be within 9 months from the date of issue of work-\nto-proceed notice/ 2 months from the date of receipt of bullets and its associated\npiping at contractor’s yard, whichever is later.",
    "is_boilerplate": false,
    "is_superseded": false
  },
