  {
    "qa_id": "IND-Q-02104",
    "doc_id": "DOC-071",
    "category_id": "CAT-015",
    "question": "Highlight the parts (if any) of this contract related to \"Survival Period\". Details: Which obligations survive termination or expiry of this contract, and for how long?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC071-CAT015",
    "answers": [
      {
        "text": "The expiry or termination of this Agreement shall not affect any accrued rights,\nobligations and liabilities of the Parties under this Agreement, including the right to\nreceive penalty as per the terms of this Agreement, nor shall it affect the survival of\nany continuing obligations for which this Agreement provides, either expressly or\nby necessary implication, which are to survive after the Expiry Date or termination\nincluding those under Article 11 (Force Majeure), Article 13 (Events of Default and\nTermination), Article 14 (Liability and Indemnification), Article 16 (Governing\nLaw and  Dispute Resolution), Article 17 (Miscellaneous Provisions), and other\nArticles and Schedules of this Agreement which expressly or by their nature survive\nthe Term or termination of this Agreement shall continue and survive any expiry or\ntermination of this Agreement.",
        "answer_start": 48480,
        "answer_end": 49343,
        "paragraph_id": "PAR-DOC071-0082"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
