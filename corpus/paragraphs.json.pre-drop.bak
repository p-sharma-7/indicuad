    "doc_id": "DOC-083",
    "paragraph_index": 42,
    "page_start": 6,
    "page_end": 6,
    "char_start": 10558,
    "char_end": 10769,
    "char_count": 211,
    "text": "5.2 Also in consideration of the terms and conditions of this Agreement, Licensee\nagrees to pay IITK _____ percent of the net royalty, Licensee receives from licenses\nto third parties pursuant to this Agreement.",
