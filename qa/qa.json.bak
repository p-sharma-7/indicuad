    "qa_id": "IND-Q-01812",
    "doc_id": "DOC-067",
    "category_id": "CAT-014",
    "question": "what happens if they mess up can we cancel",
    "question_register": "naive_layperson",
    "intent_group_id": "IG-DOC067-CAT014",
    "answers": [
      {
        "text": "If the CONTRACTOR refuses or fails to execute the WORK or any separate part thereof with such diligence as will ensure its\ncompletion within the time specified in the CONTRACT or extension thereof or fails to perform any of his obligation under the\nCONTRACT or in any manner commits a breach of any of the provisions of the CONTRACT it shall be open to the EMPLOYER at\nits option by written notice to the CONTRACTOR:",
        "answer_start": 62289,
        "answer_end": 62705,
        "paragraph_id": "PAR-DOC067-0076"
      },
      {
        "text": "If the Contractor shall dissolve or become\nbankrupt or insolvent or cause or suffer any receiver to be appointed of his business of any assets thereof compound with his\nCreditors, or being a corporation commence to be wound up, not being a member’s voluntary winding up for the purpose of\namalgamation or reconstruction, or carry on its business under a Receiver for the benefits of its Creditors any of them,\nEMPLOYER shall be at liberty",
        "answer_start": 70351,
        "answer_end": 70789,
        "paragraph_id": "PAR-DOC067-0085"
      }
    ],
    "is_impossible": false,
