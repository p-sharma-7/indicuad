    "page_end": 43,
    "char_start": 91673,
    "char_end": 91945,
    "char_count": 272,
    "text": "We undertake to pay to the Company any money so demanded notwithstanding any dispute or disputes\nraised by the said contractor in any suit or proceedings pending before any court or tribunal relating thereto\nour liability under this present being absolute and unequivocal.",
    "is_boilerplate": false,
    "is_superseded": false
  },
