  {
    "qa_id": "IND-Q-02611",
    "doc_id": "DOC-081",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC081-CAT016",
    "answers": [
      {
        "text": "Save where expressly stated to the contrary in this document, any dispute,  difference or\ncontroversy of whatever nature between the Parties, howsoever arising under, out of or in\nrelation to this document, including those arising with regard to acts, decision or opinion of\nthe EPI (the “Dispute”) and so notified in writing by either",
        "answer_start": 290774,
        "answer_end": 291109,
        "paragraph_id": "PAR-DOC081-0231"
      },
      {
        "text": "If the dispute is not amicably settled within 15 (fifteen) days of reference of said dispute,\neither party may refer the dispute to mediation in accordance with the provisions of below:\nMediation\nIn case of any dispute / differences, such dispute shall be referred for mediation by either\nparties to CMD of EPI for resolution of dispute and CMD may nominate any person / committee\nfor mediation of the dispute. If such dispute is not resolved within a period of 30 days from\nthe date of reference to CMD of EPI, then in such a case matter / dispute shall be referred\nto the Court for resolution.",
        "answer_start": 291883,
        "answer_end": 292478,
        "paragraph_id": "PAR-DOC081-0233"
      },
      {
        "text": "Jurisdiction\nSCC\nCourts in New Delhi",
        "answer_start": 43784,
        "answer_end": 43820,
        "paragraph_id": "PAR-DOC081-0033"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC081-0033",
      "PAR-DOC081-0231",
      "PAR-DOC081-0233"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
