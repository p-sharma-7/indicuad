    "char_start": 442604,
    "char_end": 442773,
    "char_count": 169,
    "text": "(c) the firm or any of its partners should not have been disqualified or black-listed by the\nComptroller and Auditor General of India or the Concessioning Authority; and",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
