  {
    "qa_id": "IND-Q-01753",
    "doc_id": "DOC-065",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT020",
    "answers": [
      {
        "text": "In case the Service Provider fails to mobilize / deploy\nthe required manpower and the complete equipments so as to commence the Services\nwithin Mobilisation Period and complete the Services within the stipulated period, then,\nunless such failure is due to Force Majeure as defined in Clause 2.21 herein above or due\nto Employer's defaults, the total Value of Contract shall be reduced by ½ (half) % of the\ntotal Value of Contract per complete week of delay or part thereof subject to a maximum\nof 5 (five) % of the total Value of Contract, by way of reduction in price for delay and not\nas penalty.",
        "answer_start": 48921,
        "answer_end": 49519,
        "paragraph_id": "PAR-DOC065-0182"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
