    "paragraph_index": 321,
    "page_start": 77,
    "page_end": 77,
    "char_start": 171811,
    "char_end": 172095,
    "char_count": 284,
    "text": "17.5\nSeverability\n\n17.5.1 The invalidity or unenforceability, for any reason, of any part of this Agreement shall\nnot prejudice or affect the validity or enforceability of the remainder of this\nAgreement, unless the part held invalid or unenforceable is fundamental to this\nAgreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC071-0322",
    "doc_id": "DOC-071",
    "paragraph_index": 322,
    "page_start": 77,
    "page_end": 77,
    "char_start": 172097,
    "char_end": 172253,
    "char_count": 156,
    "text": "17.6\nNotices\n17.6.1 All notices or other communications which are required to be given under this\nAgreement shall be in writing and in the English language.",
    "is_boilerplate": false,
    "is_superseded": false
  },
