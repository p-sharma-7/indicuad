    "paragraph_index": 5,
    "page_start": 1,
    "page_end": 1,
    "char_start": 824,
    "char_end": 1148,
    "char_count": 324,
    "text": "Pursuant to Regulation 30 of the SEBI (Listing Obligations and Disclosure Requirements) Regulations,\n2015 (“Listing Regulations”), we wish to inform that Innomet Advanced Materials Limited has received\na Purchase Order dated February 12, 2026 from Hoganas India Pvt Ltd, an Indian Corporate, for the\nsupply of Copper Powder.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC035-0006",
    "doc_id": "DOC-035",
