  {
    "qa_id": "IND-Q-01795",
    "doc_id": "DOC-067",
    "category_id": "CAT-009",
    "question": "Highlight the parts (if any) of this contract related to \"No-Solicit of Employees\". Details: Is there a restriction on soliciting or hiring the other party's employees?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC067-CAT009",
    "answers": [
      {
        "text": "No Engineer of Gazetted rank or other Gazetted Officer employed in Engineering or Administrative duties in an Engineering\nDepartment of the States/ Central Government or of the EMPLOYER is allowed to work as a CONTRACTOR for a period of two\nyears after his retirement from Government Service, or from the employment of the EMPLOYER without the previous\npermission of the EMPLOYER. The CONTRACT, if awarded, is liable to be cancelled if either the CONTRACTOR or any of his\nemployees is found at any time to be such a person, who has not obtained the permission of the State/Central Government or\nof the EMPLOYER as aforesaid before submission of tender, or engagement in the CONTRACTOR'S service as the case may be.",
        "answer_start": 39010,
        "answer_end": 39724,
        "paragraph_id": "PAR-DOC067-0051"
      }
    ],
    "is_impossible": false,
