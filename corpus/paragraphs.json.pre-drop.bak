    "char_start": 1360,
    "char_end": 1492,
    "char_count": 132,
    "text": "This disclosure is being made pursuant to Regulation 30 read with Para B of Part A of Schedule III\nof SEBI (LODR) Regulations, 2015.",
    "is_boilerplate": false,
    "is_superseded": false
  },
