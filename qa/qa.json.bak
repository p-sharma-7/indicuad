  {
    "qa_id": "IND-Q-02320",
    "doc_id": "DOC-074",
    "category_id": "CAT-015",
    "question": "Highlight the parts (if any) of this contract related to \"Survival Period\". Details: Which obligations survive termination or expiry of this contract, and for how long?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC074-CAT015",
    "answers": [
      {
        "text": "The expiry or termination of this Agreement shall not affect any accrued rights,\nobligations and liabilities of the Parties under this Agreement, including the right to\nreceive penalty as per the terms of this Agreement, nor shall it affect the survival of\nany continuing obligations for which this Agreement provides, either expressly or by\nnecessary implication, which are to survive after the Expiry Date or termination\nincluding those under Article 11 (Force Majeure), Article 13 (Events of Default and\nTermination), Article 14 (Liability and Indemnification), Article 16 (Governing  Law\nand Dispute Resolution), Article 17 (Miscellaneous Provisions), and other Articles and\nSchedules of this Agreement which expressly or by their nature survive the Term or\ntermination of this Agreement shall continue and survive any expiry or termination of\nthis Agreement.",
        "answer_start": 32583,
        "answer_end": 33446,
        "paragraph_id": "PAR-DOC074-0062"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
