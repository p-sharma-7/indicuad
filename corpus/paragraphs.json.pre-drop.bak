    "char_end": 31856,
    "char_count": 150,
    "text": "Page 16 of 28\n\nConciliation (Amendment) Act, 2015. When such conciliation has failed, the\nparties shall adopt the following procedure for arbitration:",
    "is_boilerplate": false,
