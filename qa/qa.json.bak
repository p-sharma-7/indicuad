  {
    "qa_id": "IND-Q-01723",
    "doc_id": "DOC-065",
    "category_id": "CAT-009",
    "question": "Highlight the parts (if any) of this contract related to \"No-Solicit of Employees\". Details: Is there a restriction on soliciting or hiring the other party's employees?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT009",
    "answers": [
      {
        "text": "No Employee/Officer employed in Engineering or Administrative duties in an\nEngineering Department of the States/ Central Government or of the Employer is allowed\nto service as a Service Provider for a period of one year after his retirement /resignation\n/severance from Government Service or from the employment of the Employer without\nthe previous permission of the Employer. The Contract, if awarded, is liable to be\nterminated if either the Service Provider or any of his employees is found at any time to\nbe such a person, who has not obtained the permission of the State/Central Government\nor of the Employer as aforesaid before submission of tender, or engagement in the\nService Provider's service as the case may be.",
        "answer_start": 19273,
        "answer_end": 19996,
        "paragraph_id": "PAR-DOC065-0087"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
