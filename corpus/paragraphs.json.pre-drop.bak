    "char_end": 118192,
    "char_count": 168,
    "text": "6. Certificates\nBidder's offer is liable to be rejected if they don't upload any of the certificates / documents sought in the\nBid document, ATC and Corrigendum if any.",
    "is_boilerplate": false,
    "is_superseded": false
