  {
    "qa_id": "IND-Q-02815",
    "doc_id": "DOC-086",
    "category_id": "CAT-010",
    "question": "Highlight the parts (if any) of this contract related to \"Confidentiality Scope\". Details: What confidential information must be protected, and what is the obligation of confidentiality?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC086-CAT010",
    "answers": [
      {
        "text": "The Parties hereby acknowledge and agree that each of them possess and will continue to\npossess information that has been created, discovered, developed, or otherwise known and\nowned by them, which information has commercial value in the business in which they are\nor may become engaged (the aforementioned information is hereinafter called\n\"Proprietary Information\"). The Parties, on behalf of themselves, agree that during the\nterms of this Agreement and after the termination or expiration hereof, each of them will\nkeep in confidence and trust all Proprietary Information received from the other Party, and\nthey will not use or disclose any such Proprietary Information or anything directly relating\nto it without the written consent of the other Party(s).",
        "answer_start": 605078,
        "answer_end": 605838,
        "paragraph_id": "PAR-DOC086-1180"
      }
    ],
