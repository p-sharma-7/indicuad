    "page_end": 84,
    "char_start": 200538,
    "char_end": 200755,
    "char_count": 217,
    "text": "(ii) the duration or estimated duration and the effect or probable effect which such Force\nMajeure Event has or will have on the Affected Party’s ability to perform its obligations or any\nof them under this Agreement;",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0450",
    "doc_id": "DOC-076",
    "paragraph_index": 450,
    "page_start": 84,
    "page_end": 84,
    "char_start": 200756,
    "char_end": 200912,
    "char_count": 156,
    "text": "(iii) the measures which the Affected Party has taken or proposes to take, to alleviate the impact\nof the Force Majeure Event or to mitigate the damage; and",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0451",
