    "page_end": 57,
    "char_start": 140253,
    "char_end": 140498,
    "char_count": 245,
    "text": "(ii) Approvals\nThe Concessioning Authority shall promptly grant approvals/ consents sought by the\nConcessionaire as required under this Agreement subject to the Concessionaire having complied\nwith all Applicable Laws/requirements in this regard.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC076-0299",
