    "char_start": 222083,
    "char_end": 222530,
    "char_count": 447,
    "text": "shall be extended to such required period on receiving instructions from M/s------------------------------------------------------------------------\n------- on whose behalf this guarantee is issued.\nIn Witness whereof the Bank, through its authorized officer, has set its hand and stamp on this -----------------------------------day of ----\n---------------------2013  -------------------------- at --------------------------\nWITNESS :\n(SIGNATURE)",
    "is_boilerplate": false,
    "is_superseded": false
  },
