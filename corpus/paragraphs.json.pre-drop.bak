    "doc_id": "DOC-087",
    "paragraph_index": 33,
    "page_start": 7,
    "page_end": 7,
    "char_start": 10550,
    "char_end": 11014,
    "char_count": 464,
    "text": "1.7. For all purposes of the contract including arbitration thereunder, the address of the bidder\nmentioned in the bid shall be final unless the bidder notifies a change of address by a separate\nletter sent by registered post with acknowledgement due to the Office of the Accountant\nGeneral (Audit-II), Madhya Pradesh, Bhopal. The bidder shall be solely responsible for the\nconsequences of any omission or error to notify change of address in the aforesaid manner.",
    "is_boilerplate": false,
    "is_superseded": false
  },
