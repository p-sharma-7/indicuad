  {
    "qa_id": "IND-Q-01669",
    "doc_id": "DOC-064",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT016",
    "answers": [
      {
        "text": "If  the  Parties  fail  to  reach  an  amicable  settlement  through  the\nprocesses of Mutual Consultation and Conciliation through ESC, then\neither Party (the PURCHASER or the SELLER) may within thirty (30)\ndays of such failure give a written notice to the other Party requiring\nthat all matters in dispute or difference or in question be arbitrated\nupon in accordance with The Arbitration and Conciliation Act 1996.",
        "answer_start": 90040,
        "answer_end": 90457,
        "paragraph_id": "PAR-DOC064-0220"
      },
      {
        "text": "any and all actions and proceedings arising out of or\nrelating to the contract or any Award arising therefrom, shall lie only in the Court\nof competent civil jurisdiction in this behalf at Bengaluru/Kolkata and only the\nsaid Court(s) at Bengaluru/Kolkata shall have jurisdiction to entertain and take\nany such actions and/or proceedings to the exclusion of all other Courts.",
        "answer_start": 93671,
        "answer_end": 94045,
        "paragraph_id": "PAR-DOC064-0227"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC064-0220",
      "PAR-DOC064-0227"
    ],
    "doc_origin": "collected_real",
