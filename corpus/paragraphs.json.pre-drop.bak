    "char_start": 258446,
    "char_end": 258586,
    "char_count": 140,
    "text": "(ii) Part Right of Way\n(part width)\n(a)\nsection\n(b)\nsection\n(c) section\n\n(iii) Balance Right of\nWay (width)\na)\nsection\nb) section\nc)\nsection",
    "is_boilerplate": false,
