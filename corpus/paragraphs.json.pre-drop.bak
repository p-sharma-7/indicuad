    "doc_id": "DOC-070",
    "paragraph_index": 53,
    "page_start": 10,
    "page_end": 10,
    "char_start": 20758,
    "char_end": 20852,
    "char_count": 94,
    "text": "18.1. Quantity, items & works as mentioned in the price bid are completely tentative in nature",
