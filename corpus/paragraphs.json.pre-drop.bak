    "char_start": 61122,
    "char_end": 61196,
    "char_count": 74,
    "text": "Draft for discussion purposes only\n30\n\nARTICLE 8\nRIGHT OF WAY\n8.1\nThe Site",
    "is_boilerplate": false,
    "is_superseded": false
  },
