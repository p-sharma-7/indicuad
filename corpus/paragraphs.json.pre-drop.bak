    "char_count": 6,
    "text": "NOTES:",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0708",
    "doc_id": "DOC-086",
    "paragraph_index": 708,
    "page_start": 214,
    "page_end": 214,
    "char_start": 407044,
    "char_end": 407160,
    "char_count": 116,
    "text": "(i)\nThe bank guarantee should contain the name, designation and code number of the officer(s)\nsigning the guarantee.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0709",
    "doc_id": "DOC-086",
    "paragraph_index": 709,
    "page_start": 214,
    "page_end": 214,
    "char_start": 407162,
    "char_end": 407331,
    "char_count": 169,
    "text": "The address, telephone number and other details of the Head Office of the Bank as well as of issuing\nBranch should be mentioned on the covering letter of issuing Branch.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0710",
    "doc_id": "DOC-086",
    "paragraph_index": 710,
    "page_start": 215,
    "page_end": 215,
    "char_start": 407333,
    "char_end": 407336,
    "char_count": 3,
    "text": "215",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0711",
    "doc_id": "DOC-086",
    "paragraph_index": 711,
