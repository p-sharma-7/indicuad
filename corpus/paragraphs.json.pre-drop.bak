    "page_end": 86,
    "char_start": 205242,
    "char_end": 205448,
    "char_count": 206,
    "text": "(i) before COD, the Concession Period and the dates set forth in the Project Completion\nSchedule shall be extended by a period equal in length to the duration for which such Force\nMajeure Event subsists; or",
    "is_boilerplate": false,
    "is_superseded": false
  },
