  {
    "qa_id": "IND-Q-02755",
    "doc_id": "DOC-085",
    "category_id": "CAT-014",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Cause\". Details: Can a party terminate this contract for cause, such as breach, default, or insolvency?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC085-CAT014",
    "answers": [
      {
        "text": "In the event that either Party believes that the other Party is in Material Breach of\nits obligations under this Agreement, such aggrieved Party may terminate this\nAgreement upon giving a one month’s notice for curing the Material Breach to the\nother Party. In case the Material Breach continues, after the notice period, the\nPurchaser or Managed Service Provider, as the case may be will have the option to\nterminate the Agreement. Any notice served pursuant to this Clause shall give\nreasonable details of the Material Breach, which could include the following events\nand the termination will become effective:",
        "answer_start": 55658,
        "answer_end": 56270,
        "paragraph_id": "PAR-DOC085-0098"
      },
      {
        "text": "Termination of this Agreement due to Bankruptcy of Managed Service\nProvider",
        "answer_start": 61554,
        "answer_end": 61629,
        "paragraph_id": "PAR-DOC085-0110"
      }
    ],
