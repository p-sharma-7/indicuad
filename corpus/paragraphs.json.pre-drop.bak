    "char_start": 2705,
    "char_end": 2936,
    "char_count": 231,
    "text": "The details as required under SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015\nread with SEBI Master Circular No. HO/49/14/14(7)2025-CFD-POD2/I/3762/2026 dated January 30,\n2026, is enclosed as an Annexure A.",
    "is_boilerplate": false,
    "is_superseded": false
  },
