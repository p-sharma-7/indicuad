  {
    "qa_id": "IND-Q-02482",
    "doc_id": "DOC-079",
    "category_id": "CAT-022",
    "question": "Highlight the parts (if any) of this contract related to \"Warranty Duration\". Details: What is the duration of any warranty against defects or errors in goods or services provided?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC079-CAT022",
    "answers": [
      {
        "text": "The Contractor shall be responsible for all the Defects and deficiencies, except usual\nwear and tear in the Project or any Section thereof, till the expiry of a period of 2 (two)\nyears commencing from the date of Provisional Certificate or expiry of a period of 18\n(eighteen) months from the date of Completion Certificate, whichever is later (the\n“Defects Liability Period”).\n15.1.2 Without prejudice to the provisions of Clause 15.1.1, the Defects Liability Period for\nand in respect of any Structure or Major Bridge having a construction cost exceeding\nRs.50 crore (Rupees fifty crore) each, as estimated in accordance with the provisions\nof Schedule-G, shall be deemed to be extended by a further period of 3 (three) years\nafter the expiry of the Defects Liability Period specified in Clause 17.1.1.",
        "answer_start": 130899,
        "answer_end": 131702,
        "paragraph_id": "PAR-DOC079-0288"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC079-0288"
    ],
    "doc_origin": "collected_real",
