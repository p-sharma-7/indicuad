  },
  {
    "paragraph_id": "PAR-DOC073-0081",
    "doc_id": "DOC-073",
    "paragraph_index": 81,
    "page_start": 24,
    "page_end": 24,
    "char_start": 48290,
    "char_end": 48666,
    "char_count": 376,
    "text": "4.8    The duly executed Power Purchase Agreement between SECI and SPD shall be\nattached to this Agreement and shall be read along with Agreement as a composite\nback to back process for Generation and supply of electricity to Buying Entity to\nfulfill the Renewable Purchase Obligations under the provisions of the Electricity\nAct, 2003 and the Regulations notified thereunder.",
