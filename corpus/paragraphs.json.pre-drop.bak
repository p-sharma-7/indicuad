    "doc_id": "DOC-087",
    "paragraph_index": 431,
    "page_start": 52,
    "page_end": 52,
    "char_start": 117843,
    "char_end": 118023,
    "char_count": 180,
    "text": "5. Service & Support\nAVAILABILITY OF OFFICE OF SERVICE PROVIDER: An office of the Service Provider must be located in the\nstate of Consignee.  DOCUMENTARY EVIDENCE TO BE SUBMITTED.",
    "is_boilerplate": false,
    "is_superseded": false
  },
