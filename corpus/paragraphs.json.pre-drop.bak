    "page_end": 11,
    "char_start": 21117,
    "char_end": 21263,
    "char_count": 146,
    "text": "2.10\nGENERAL OBLIGATIONS OF SERVICE PROVIDER\n\nService Provider shall, in accordance with and subject to the terms and conditions of this\nContract:",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
