    "char_start": 779,
    "char_end": 963,
    "char_count": 184,
    "text": "WHEREAS, the Lessor, is the owner of the premises bearing no. [.], having total area measuring about [.] sq. metres, situated at [.], hereinafter referred to as the “Demised Premises”.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
