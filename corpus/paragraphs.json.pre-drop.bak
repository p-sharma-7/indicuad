    "page_start": 33,
    "page_end": 33,
    "char_start": 79372,
    "char_end": 79580,
    "char_count": 208,
    "text": "security breaches by unauthorized persons (including unauthorized persons who are\nemployees of any Party) either to gain access to or interfere with the Project's Data,\nfacilities or Confidential Information.",
    "is_boilerplate": false,
    "is_superseded": false
  },
