    "char_start": 116181,
    "char_end": 116306,
    "char_count": 125,
    "text": "3. Generic\n1. The Seller shall not assign the Contract in whole or part without obtaining the prior written consent of\nbuyer.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC087-0428",
