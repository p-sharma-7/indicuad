    "char_count": 81,
    "text": "(a)\nonly such skilled and experienced personnel(s) in their respective areas; and",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC065-0120",
    "doc_id": "DOC-065",
    "paragraph_index": 120,
    "page_start": 13,
    "page_end": 13,
    "char_start": 26515,
    "char_end": 26678,
    "char_count": 163,
