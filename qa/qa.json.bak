  {
    "qa_id": "IND-Q-01663",
    "doc_id": "DOC-064",
    "category_id": "CAT-014",
    "question": "Highlight the parts (if any) of this contract related to \"Termination for Cause\". Details: Can a party terminate this contract for cause, such as breach, default, or insolvency?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC064-CAT014",
    "answers": [
      {
        "text": "BRBNMPL, without prejudice to any other contractual rights and remedies\navailable to it for breach of contract, such as removal from the list of\nregistered supplier, may, by written notice of default sent to the supplier,\nterminate the contract in whole or in part:",
        "answer_start": 70762,
        "answer_end": 71027,
        "paragraph_id": "PAR-DOC064-0173"
      },
      {
        "text": "In the event the supplier becomes bankrupt or otherwise insolvent or loses\nsubstantially the technical or financial capability (based on which he was\nselected for award of contract) or liquidation proceedings are commenced\nagainst it by a third party or by own volition, BRBNMPL reserves the right\nto terminate the contract, at any time, by serving written notice to the\nsupplier, without any adverse consequence to BRBNMPL and without\nbeing liable to pay any compensation, whatsoever, to the supplier, subject\nto further condition that such termination will not prejudice or affect any\nrights of action or remedies which have accrued or will accrue prior to\ntermination or thereafter to BRBNMPL.",
        "answer_start": 73453,
        "answer_end": 74149,
        "paragraph_id": "PAR-DOC064-0184"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC064-0173",
      "PAR-DOC064-0184"
    ],
