    "page_start": 1,
    "page_end": 1,
    "char_start": 5678,
    "char_end": 5764,
    "char_count": 86,
    "text": "12. That either party may terminate this agreement at his option at any time after the",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC057-0024",
    "doc_id": "DOC-057",
    "paragraph_index": 24,
