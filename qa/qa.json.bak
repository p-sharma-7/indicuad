  {
    "qa_id": "IND-Q-01963",
    "doc_id": "DOC-069",
    "category_id": "CAT-017",
    "question": "Highlight the parts (if any) of this contract related to \"Payment Terms & Schedule\". Details: What are the payment amounts, milestones, and due dates?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC069-CAT017",
    "answers": [
      {
        "text": "Payments will be made through monthly running account bills based on the worksexecuted on the\nbasis of recorded measurements. The running account bills shall besubmitted by the contractor for\nthe works executed on the basis of recorded measurementson the format of the Institute in triplicate\non or before the date of every month fixed byEngineer-In-Charge.",
        "answer_start": 34959,
        "answer_end": 35316,
        "paragraph_id": "PAR-DOC069-0076"
      },
      {
        "text": "The final bill shall be submitted by the contractor in the same manner as specified ininterim bills\nwithin three months of physical completion of the work or within one month ofthe date of the final\ncertificate of completion furnished by the Engineer-in-Chargewhichever is earlier.",
        "answer_start": 41691,
        "answer_end": 41972,
        "paragraph_id": "PAR-DOC069-0088"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC069-0076",
      "PAR-DOC069-0088"
    ],
    "doc_origin": "collected_real",
