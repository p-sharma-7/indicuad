    "char_end": 6266,
    "char_count": 187,
    "text": "10. No neglect, delay, indulgence, forbearance or waiver on the part of the owner in\nenforcing any terms or conditions of this agreement shall prejudice the rights of the owner\nhereunder.",
    "is_boilerplate": false,
