    "char_start": 24036,
    "char_end": 24405,
    "char_count": 369,
    "text": "14.5. Licensee shall exercise all reasonable precautions to prevent the disclosure of\nConfidential Information by its employees or representatives, and in any event shall\nmaintain with respect to such Confidential Information a standard of care which is\nnot less than that standard which Licensee maintains to prevent the disclosure of its\nown confidential information.",
    "is_boilerplate": false,
    "is_superseded": false
  },
