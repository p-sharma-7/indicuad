    "doc_id": "DOC-070",
    "paragraph_index": 79,
    "page_start": 14,
    "page_end": 14,
    "char_start": 29517,
    "char_end": 29787,
    "char_count": 270,
    "text": "35.\nBLASTING:   NA\n\n36.\nPRIORITY OF WORK:\nThe contractor has to deploy resources and plan the work accordingly and nothing extra\nshall be payable to the contractor on this account. The contractor has to ensure safety of the\noccupants as to avoid any hazard to occupants.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
