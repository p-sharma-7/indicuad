  {
    "qa_id": "IND-Q-02764",
    "doc_id": "DOC-085",
    "category_id": "CAT-017",
    "question": "Highlight the parts (if any) of this contract related to \"Payment Terms & Schedule\". Details: What are the payment amounts, milestones, and due dates?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC085-CAT017",
    "answers": [
      {
        "text": "The Purchaser shall pay to the Managed Service Provider for the actual consumption\nof the Cloud Services during the project duration, and not on the basis of the project\nduration.\nc) The Managed Service Provider shall not increase the fee of the Cloud Services being\nconsumed by the Purchaser during the entire duration of the project, unless there is\nan agreed provision in the Cloud Contract.\nd) The Managed Service Provider shall be responsible, as required under applicable law,\nfor identifying and paying all taxes and other governmental fees and charges (and any\npenalties, interest, and other additions thereto) that are imposed on it upon or with\nrespect to the transactions and payments under this Contract.\ne) The Purchaser may make payment to the Managed Service Provider at the end of the\nmonth, quarter or year based on the actual usage of the services and as per the “Unit\nCosts” discovered under the Commercial Proposal.",
        "answer_start": 49914,
        "answer_end": 50849,
        "paragraph_id": "PAR-DOC085-0090"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC085-0090"
    ],
    "doc_origin": "collected_real",
