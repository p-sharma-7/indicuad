    "page_end": 40,
    "char_start": 97263,
    "char_end": 97461,
    "char_count": 198,
    "text": "(e) If either Party disputes any advice, instruction or decision of the Independent Engineer, the\ndispute shall be resolved in accordance with the dispute resolution procedure set out in Article\n19.",
    "is_boilerplate": false,
    "is_superseded": false
  },
