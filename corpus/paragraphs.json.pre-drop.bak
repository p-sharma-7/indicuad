    "page_end": 327,
    "char_start": 515952,
    "char_end": 516048,
    "char_count": 96,
    "text": "ii. Delhi, Mumbai, Chennai, Kolkata, Bangalore and Hyderabad shall be considered as\nMetro Cites.",
    "is_boilerplate": false,
    "is_superseded": false
  },
