    "char_start": 6740,
    "char_end": 6996,
    "char_count": 256,
    "text": "“Relative” shall have the same meaning as defined under the Act;\n2.\nEMPLOYMENT\n2.1\nThe Company has employed the Employee to render services as described herein from the Effective Date and the\nParties hereby set forth the terms of the Employee’s employment.",
    "is_boilerplate": false,
    "is_superseded": false
  },
