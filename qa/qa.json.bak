  {
    "qa_id": "IND-Q-01744",
    "doc_id": "DOC-065",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT016",
    "answers": [
      {
        "text": "The Arbitration proceedings shall be in English language and the seat, venue and",
        "answer_start": 115780,
        "answer_end": 115860,
        "paragraph_id": "PAR-DOC065-0377"
      },
      {
        "text": "place of Arbitration shall be New Delhi, India only.\n2.5\nSubject to the above, the provisions of Arbitration & Conciliation Act 1996 and\nany amendment thereof shall be applicable. All matter relating to this Contract and\narising out of invocation of Arbitration clause are subject to the exclusive\njurisdiction of the Court(s) situated at New Delhi.",
        "answer_start": 115861,
        "answer_end": 116210,
        "paragraph_id": "PAR-DOC065-0378"
      },
      {
        "text": "The Parties hereby submit to the exclusive jurisdiction of the\nCompetent Courts of Dibrugarh having territorial & pecuniary jurisdiction for\nadjudication of disputes, injunctive reliefs, actions and proceedings, if any, arising\nout of this Contract other than those covered under the arbitration clause as stated\nherein above.",
        "answer_start": 117310,
        "answer_end": 117636,
        "paragraph_id": "PAR-DOC065-0382"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC065-0377",
      "PAR-DOC065-0378",
      "PAR-DOC065-0382"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
