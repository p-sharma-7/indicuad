    "char_end": 1715,
    "char_count": 184,
    "text": "2. Term\n\nThis Agreement shall come into force on the Effective Date and shall continue to be valid for [__] months\n(“Term”) unless terminated earlier in accordance with this Agreement.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
