  },
  {
    "paragraph_id": "PAR-DOC088-0072",
    "doc_id": "DOC-088",
    "paragraph_index": 72,
    "page_start": 12,
    "page_end": 12,
    "char_start": 24000,
    "char_end": 24544,
    "char_count": 544,
    "text": "26. Dispute Settlement\na) It is mutually agreed that all differences and disputes arising out of or in connection\nwith this Agreement shall be settled by mutual discussions and negotiations if such\ndisputes and differences cannot be settled and resolved by discussions and negotiations\nthen the same shall be referred to the Sole Arbitrator appointed by the Medical\nSuperintendent, ESIC Model Hospital, Bapunagar whose decision shall be final and\nbinding on both the parties.\nb) Any legal dispute will be subject to Ahmedabad Jurisdiction only.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC088-0073",
    "doc_id": "DOC-088",
    "paragraph_index": 73,
    "page_start": 12,
    "page_end": 13,
    "char_start": 24546,
    "char_end": 24583,
    "char_count": 37,
    "text": "Medical Superintendent\n\nPage 13 of 35",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC088-0074",
    "doc_id": "DOC-088",
    "paragraph_index": 74,
    "page_start": 13,
    "page_end": 13,
    "char_start": 24585,
    "char_end": 24619,
    "char_count": 34,
    "text": "Initial of ESIC authorised officer",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC088-0075",
    "doc_id": "DOC-088",
    "paragraph_index": 75,
    "page_start": 13,
    "page_end": 13,
    "char_start": 24621,
    "char_end": 24658,
