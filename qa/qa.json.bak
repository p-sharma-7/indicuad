  {
    "qa_id": "IND-Q-02110",
    "doc_id": "DOC-071",
    "category_id": "CAT-017",
    "question": "Highlight the parts (if any) of this contract related to \"Payment Terms & Schedule\". Details: What are the payment amounts, milestones, and due dates?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC071-CAT017",
    "answers": [
      {
        "text": "The RPD shall issue to SECI hard copy of a signed Monthly Bill/Supplementary Bill\nfor the immediately preceding Month/relevant period based on the issuance of\nEnergy Accounts along with all relevant documents (payments made by RPD for\ndrawal of power, payment of reactive energy charges, Metering charges or any other\ncharges as per guidelines of SERC/CERC, if applicable.\nEach Monthly Bill shall include all charges as per this Agreement for the energy\nsupplied for the relevant Month based on Energy Accounts issued by RPC or any\nother competent authority which shall be binding on both the Parties.",
        "answer_start": 108074,
        "answer_end": 108675,
        "paragraph_id": "PAR-DOC071-0179"
      },
      {
        "text": "In the event of delay in payment of a Monthly Bill by SECI beyond the Due Date, a\nLate Payment Surcharge shall be payable to the RPD at the rate of 1.25% per month\non the outstanding amount calculated on a day to day basis subject to such late\npayment surcharge being duly received by SECI under the PSA from the Buying\nEntity(ies). The Late Payment Surcharge shall be claimed by the RPD through the\nSupplementary Bill.",
        "answer_start": 110678,
        "answer_end": 111097,
        "paragraph_id": "PAR-DOC071-0185"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC071-0179",
      "PAR-DOC071-0185"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
