    "char_start": 269677,
    "char_end": 269921,
    "char_count": 244,
    "text": "occurring prior to such opening or operation of the Competing Facility.\n36.4.2 Payment of compensation under this Clause 35.4 shall be deemed to cure the breach of this\nAgreement so long as the Authority continues to pay compensation hereunder.",
    "is_boilerplate": false,
    "is_superseded": false
  },
