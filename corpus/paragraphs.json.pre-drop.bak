    "char_start": 1150,
    "char_end": 1278,
    "char_count": 128,
    "text": "The total consideration of the said Purchase Order is Rs. 59.27 Lakhs (approximately), inclusive of\napplicable taxes and duties.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
