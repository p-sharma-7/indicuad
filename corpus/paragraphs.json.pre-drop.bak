    "doc_id": "DOC-068",
    "paragraph_index": 285,
    "page_start": 43,
    "page_end": 43,
    "char_start": 91947,
    "char_end": 92141,
    "char_count": 194,
    "text": "The payment so made by us under this guarantee shall be a valid discharge of our liability for payment there\nunder and the said contractor shall have no claim against us for making such payment.",
