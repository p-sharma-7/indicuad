  {
    "qa_id": "IND-Q-02845",
    "doc_id": "DOC-086",
    "category_id": "CAT-021",
    "question": "Highlight the parts (if any) of this contract related to \"Insurance\". Details: Is either party required to maintain insurance?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC086-CAT021",
    "answers": [
      {
        "text": "The Concessionaire shall effect and maintain at its own cost, during the Construction\nPeriod and the Operation Period, such insurances for such maximum sums as may be\nrequired under the Financing Agreements, and the Applicable Laws, and such insurances\nas may be necessary or prudent in accordance with Good Industry Practice. The\nConcessionaire shall also effect and maintain such insurances as may be necessary for\nmitigating the risks that may devolve on the Authority as a consequence of any act or\nomission of the Concessionaire during the Construction Period. The Concessionaire shall\nprocure that in each insurance policy, the Authority shall be a co-insured and that the\ninsurer shall pay the proceeds of insurance into the Escrow Account.",
        "answer_start": 240798,
        "answer_end": 241545,
        "paragraph_id": "PAR-DOC086-0430"
      }
    ],
    "is_impossible": false,
