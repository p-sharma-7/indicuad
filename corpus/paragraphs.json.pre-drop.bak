    "doc_id": "DOC-070",
    "paragraph_index": 30,
    "page_start": 7,
    "page_end": 7,
    "char_start": 11300,
    "char_end": 11431,
    "char_count": 131,
    "text": "8.4. The SDPBG shall be returned to the contractor after successful completion of Defect\nLiability Period as accepted by EPIL/ESIC.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC070-0031",
    "doc_id": "DOC-070",
    "paragraph_index": 31,
