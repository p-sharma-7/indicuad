    "page_start": 11,
    "page_end": 11,
    "char_start": 21548,
    "char_end": 21724,
    "char_count": 176,
    "text": "a. Annexure-1: The Bidder shall be required to print \"Bid Submission Form' as per Annexure-1\non entity's letterhead, sign, scan and upload it online with the Bid in GeM Portal.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
