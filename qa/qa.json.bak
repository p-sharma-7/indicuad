  {
    "qa_id": "IND-Q-02035",
    "doc_id": "DOC-070",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC070-CAT016",
    "answers": [
      {
        "text": "any disputes and\ndifferences relating to the meaning of the Specifications, Design, Drawing and\nInstructions herein before mentioned and as to the quality of workmanship or\nmaterials used in the work or as to any other questions, claim, right, matter or\nthings whatsoever in any way arising out of or relating to the Contract,\nDesigns, Drawings, Specifications, Estimates, Instructions, or these\nconditions or otherwise concerning the works of the execution or failure to\nexecute the same whether arising during the progress of the work or after the\ncompletion or abandonment thereof shall be referred to the Sole Arbitrator\nmutually agreed and appointed by both the parties as per the provisions of\nArbitration and Conciliation Act, 2015 or any statutory modification or re-\nenactment thereof and the rules made thereunder.",
        "answer_start": 31918,
        "answer_end": 32742,
        "paragraph_id": "PAR-DOC070-0090"
      },
      {
        "text": "The courts in Chennai alone will have jurisdiction to deal with matters arising from the\ncontract.",
        "answer_start": 35221,
        "answer_end": 35319,
        "paragraph_id": "PAR-DOC070-0101"
      }
    ],
