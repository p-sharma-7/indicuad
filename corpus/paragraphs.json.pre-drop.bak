    "paragraph_index": 126,
    "page_start": 16,
    "page_end": 16,
    "char_start": 35608,
    "char_end": 35856,
    "char_count": 248,
    "text": "3.2 Client shall prepare the draft Articles of Agreement in the Proforma included in this Document,\nduly incorporating all the terms of agreement between the two parties and send the same in\nduplicate to the successful Bidder for their concurrence.",
    "is_boilerplate": false,
    "is_superseded": false
  },
