  {
    "qa_id": "IND-Q-02908",
    "doc_id": "DOC-087",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC087-CAT016",
    "answers": [
      {
        "text": "Any claims, disputes and or differences (including a dispute regarding the existence, validity\nor termination of this Contract) arising out of or relating to this contract including\ninterpretation of its terms shall be resolved through joint discussion of the Authorised\nRepresentatives of the concerned parties. However, if the disputes are not resolved by the\ndiscussions as aforesaid within a period 30 days, then the matter will be referred for\nadjudication to the arbitration of a sole arbitrator to be appointed by the Client in accordance\nwith the provisions of the Arbitration and Conciliation Act 1996 and rules made thereunder\nincluding any modifications, amendments and future enactments thereto. The venue for the\nArbitration will be Bhopal and the decision of the arbitrator shall be final and binding on the\nparties.",
        "answer_start": 57040,
        "answer_end": 57870,
        "paragraph_id": "PAR-DOC087-0213"
      },
      {
        "text": "shall\nbe subject to the exclusive jurisdiction of the courts in Bhopal.",
        "answer_start": 57963,
        "answer_end": 58034,
        "paragraph_id": "PAR-DOC087-0214"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC087-0213",
      "PAR-DOC087-0214"
    ],
    "doc_origin": "collected_real",
