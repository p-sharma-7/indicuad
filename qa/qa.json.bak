    "doc_id": "DOC-065",
    "category_id": "CAT-021",
    "question": "Highlight the parts (if any) of this contract related to \"Insurance\". Details: Is either party required to maintain insurance?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC065-CAT021",
    "answers": [
      {
        "text": "Service Provider shall, at his own expense, arrange appropriate insurance to cover all\nrisks assumed by the Service Provider under this Contract in respect of its personnel\ndeputed under this Contract as well as Service Provider‟s equipment, tools and any other\nbelongings of the Service Provider or their personnel during the entire period of their\nengagement in connection with this Contract. Employer will have no liability on this\naccount. The Personnel covered must be covered to meet the liability under Employee\nCompensation Act.",
        "answer_start": 83954,
        "answer_end": 84490,
        "paragraph_id": "PAR-DOC065-0282"
      }
    ],
