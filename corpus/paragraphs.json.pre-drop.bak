    "char_start": 11016,
    "char_end": 11107,
    "char_count": 91,
    "text": "1.8. The requirements of number of Manpower (Sanitation/Housekeeping Services) and Cleaning",
    "is_boilerplate": false,
    "is_superseded": false
  },
