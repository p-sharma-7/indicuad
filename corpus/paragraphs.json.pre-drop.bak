    "paragraph_index": 705,
    "page_start": 214,
    "page_end": 214,
    "char_start": 406943,
    "char_end": 406976,
    "char_count": 33,
    "text": "For and on behalf of\nthe BANK by:",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0706",
