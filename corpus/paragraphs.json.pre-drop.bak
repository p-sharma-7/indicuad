    "char_start": 679,
    "char_end": 822,
    "char_count": 143,
    "text": "Sub.: Intimation of Receipt of Purchase Order.\nRef.: Regulation 30 of SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
