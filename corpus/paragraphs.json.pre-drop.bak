    "paragraph_index": 16,
    "page_start": 4,
    "page_end": 4,
    "char_start": 3268,
    "char_end": 3446,
    "char_count": 178,
    "text": "In this Contract (as defined here-in-after), save where the context otherwise requires, the\nfollowing words and expressions shall have the meanings respectively assigned to them:",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
