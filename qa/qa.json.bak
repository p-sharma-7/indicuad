  {
    "qa_id": "IND-Q-01888",
    "doc_id": "DOC-068",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC068-CAT016",
    "answers": [
      {
        "text": "If any dispute (s) arises out of or in connection with this contract, or in respect  of\nany defined legal relationship associated therewith or derived there from, the\nparties agree to submit the disputes to arbitration under the ICADR(International\nCentre for Alternative Dispute Resolution) Arbitration Rules 1996. The authority\nto appoint the Arbitrator shall be the International Centre for Alternative Dispute\nResolution. The number of Arbitrator shall be one and the language of the\narbitration proceedings shall be English. The place of arbitration proceedings\nshall be Ernakulam in Kerala.",
        "answer_start": 73133,
        "answer_end": 73729,
        "paragraph_id": "PAR-DOC068-0204"
      },
      {
        "text": "Any legal proceedings relating to CONTRACT shall be limited to courts of law\nunder the jurisdiction of the Kerala High Court at Ernakulam.",
        "answer_start": 73840,
        "answer_end": 73978,
        "paragraph_id": "PAR-DOC068-0206"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC068-0204",
      "PAR-DOC068-0206"
    ],
