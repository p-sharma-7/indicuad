    "page_end": 5,
    "char_start": 5574,
    "char_end": 5806,
    "char_count": 232,
    "text": "The “Engineer-In-Charge\" (EIC) means the person designated from time to time by\nEmployer and shall include those who are expressly authorized by him to act for and on\nhis behalf for operation/execution of this Contract for Services.",
    "is_boilerplate": false,
    "is_superseded": false
  },
