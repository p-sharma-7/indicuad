    "char_start": 606,
    "char_end": 622,
    "char_count": 16,
    "text": "Dear Sir/ Madam,",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC025-0004",
    "doc_id": "DOC-025",
    "paragraph_index": 4,
