    "char_start": 21457,
    "char_end": 21579,
    "char_count": 122,
    "text": "19.\nPAYMENT AGAINST EXTRA / SUPPLEMENTARY ITEMS:\nFollowing clauses shall be read in conjunction with Clause no 69.0 of GCC",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
