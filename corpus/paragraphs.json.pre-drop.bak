    "paragraph_index": 57,
    "page_start": 9,
    "page_end": 9,
    "char_start": 17303,
    "char_end": 17392,
    "char_count": 89,
    "text": "3.3 Bidders, who are eligible to be exempted from depositing EMD according to Rule-170 of",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
