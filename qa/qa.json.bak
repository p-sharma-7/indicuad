  {
    "qa_id": "IND-Q-02323",
    "doc_id": "DOC-074",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC074-CAT016",
    "answers": [
      {
        "text": "In the event CERC is the Appropriate Commission, any dispute arises claiming any change\nin or regarding determination of the tariff or any tariff related matters, or which partly or\nwholly could result in change in tariff, such dispute shall be adjudicated by the CERC. All\nother disputes shall be resolved by arbitration under the Indian Arbitration and Conciliation\nAct, 1996.",
        "answer_start": 111814,
        "answer_end": 112192,
        "paragraph_id": "PAR-DOC074-0232"
      },
      {
        "text": "Any\nlegal proceedings in respect of any matters, claims or disputes under this Agreement shall be\nunder the jurisdiction of appropriate courts in Delhi.",
        "answer_start": 110274,
        "answer_end": 110426,
        "paragraph_id": "PAR-DOC074-0225"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
