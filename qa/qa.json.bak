  {
    "qa_id": "IND-Q-02830",
    "doc_id": "DOC-086",
    "category_id": "CAT-015",
    "question": "Highlight the parts (if any) of this contract related to \"Survival Period\". Details: Which obligations survive termination or expiry of this contract, and for how long?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC086-CAT015",
    "answers": [
      {
        "text": "Termination shall:\n(a)\nnot relieve the Concessionaire or the Authority, as the case may be, of any\nobligations hereunder which expressly or by implication survive Termination\nhereof; and\n(b)\nexcept as otherwise provided in any provision of this Agreement expressly limiting\nthe liability of either Party, not relieve either Party of any obligations or liabilities\nfor loss or damage to the other Party arising out of, or caused by, acts or omissions\nof such Party prior to the effectiveness of such Termination or arising out of such\nTermination.\n48.8.2 All obligations surviving Termination shall only survive for a period of 3 (three)years\nfollowing the date of such Termination.",
        "answer_start": 335434,
        "answer_end": 336115,
        "paragraph_id": "PAR-DOC086-0552"
      }
    ],
