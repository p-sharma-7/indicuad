    "doc_id": "DOC-074",
    "paragraph_index": 322,
    "page_start": 67,
    "page_end": 67,
    "char_start": 133905,
    "char_end": 134076,
    "char_count": 171,
    "text": "ii) The SPD shall be required to demonstrate compliances with the “Technical\nRequirements for Grid Connected Solar PV Power Plants” as mentioned in the RfS and\nGuidelines.",
    "is_boilerplate": false,
    "is_superseded": false
  },
