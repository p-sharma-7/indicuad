    "paragraph_index": 71,
    "page_start": 13,
    "page_end": 13,
    "char_start": 26192,
    "char_end": 26329,
    "char_count": 137,
    "text": "A final certificate of rectification of all defects pointed out by the handing over taking\noverboard shall be obtained by the contractor.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
