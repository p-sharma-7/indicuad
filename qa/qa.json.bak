  {
    "qa_id": "IND-Q-01816",
    "doc_id": "DOC-067",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC067-CAT016",
    "answers": [
      {
        "text": "Unless otherwise specified, the matters where decision of the Engineer-in-Charge is deemed to be final and binding as\nprovided in the Agreement and the issues/disputes which cannot be mutually resolved within a reasonable time, all\ndisputes shall be referred to arbitration by Sole Arbitrator. The Employer [BCPL] shall suggest a panel of three independent\nand distinguished persons to the bidder/contractor/supplier/buyer (as the case may be) to select any one among them to\nact as the Sole Arbitrator. In the event of failure of the other parties to select the Sole Arbitrator within 30 days from the\nreceipt of the communication suggesting the panel of arbitrators, the right of selection of the sole arbitrator by the other\nparty shall stand forfeited and the EMPLOYER (BCPL) shall have discretion to proceed with the appointment of the Sole\nArbitrator. The decision of Employer on the appointment of the sole arbitrator shall be final and binding on the parties.\nThe award of sole arbitrator shall be final and binding on the parties and unless directed/awarded otherwise by the sole\narbitrator, the cost of arbitration proceedings shall be shared equally by the parties. The Arbitration proceedings shall be\nin English language and venue shall be Guwahati, India. Subject to the above, the provisions of (Indian) Arbitration &\nConciliation ACT 1996 and the Rules framed there under shall be applicable. All matter relating to this contract is subject\nto the exclusive jurisdiction of the court situated in the state of Delhi.",
        "answer_start": 185634,
        "answer_end": 187165,
        "paragraph_id": "PAR-DOC067-0222"
      },
      {
        "text": "The CONTRACTOR hereby\nsubmits to the jurisdiction of the Courts situated at Guwahati for the purposes of disputes, actions and proceedings arising\nout of the CONTRACT, the courts at Guwahati only will have the jurisdiction to hear and decide such disputed, actions and\nproceedings.",
        "answer_start": 188937,
        "answer_end": 189218,
        "paragraph_id": "PAR-DOC067-0224"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC067-0222",
      "PAR-DOC067-0224"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
