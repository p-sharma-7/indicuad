  {
    "qa_id": "IND-Q-02686",
    "doc_id": "DOC-083",
    "category_id": "CAT-016",
    "question": "Highlight the parts (if any) of this contract related to \"Dispute Resolution & Arbitration Seat\". Details: How are disputes under this contract resolved, and what is the arbitration seat or court jurisdiction?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC083-CAT016",
    "answers": [
      {
        "text": "The parties hereto shall endeavor to settle in an amicable way, all disputes or\ndifferences which may arise out of the present agreement or in connection\ntherewith. Any controversy or dispute arising under this Agreement not resolved\nshall be referred to and finally settled by arbitration in accordance with the Rules of\nConciliation and Arbitration of the International Chamber of Commerce by one or\nmore arbitrators appointed in accordance with the said rules. Arbitration shall be\nconducted in Delhi. Any award of the arbitrators shall be final and conclusive on the\nparties to this Agreement and judgment upon such award may be entered in any\ncourt having jurisdiction thereof. The jurisdiction of this agreement will be the courts\nat New Delhi (India).",
        "answer_start": 27026,
        "answer_end": 27784,
        "paragraph_id": "PAR-DOC083-0084"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC083-0084"
    ],
    "doc_origin": "collected_real",
