  {
    "qa_id": "IND-Q-02407",
    "doc_id": "DOC-076",
    "category_id": "CAT-021",
    "question": "Highlight the parts (if any) of this contract related to \"Insurance\". Details: Is either party required to maintain insurance?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC076-CAT021",
    "answers": [
      {
        "text": "The Concessionaire shall effect and maintain at its own cost, during the Concession Period, such\ninsurances for such maximum sums as may be required under the Financing Agreements and\nApplicable Laws, and such insurances as may be necessary or prudent in accordance with Good\nIndustry Practice. The Concessionaire shall also effect and maintain such insurances as may be\nnecessary for mitigating the risks that may devolve on the Concessioning Authority as a\nconsequence of any act or omission of the Concessionaire. The Concessionaire shall procure\nthat in each insurance policy, the Concessioning Authority shall be a co-insured and that the\ninsurer shall pay the proceeds of insurance into the Escrow Account.",
        "answer_start": 165681,
        "answer_end": 166393,
        "paragraph_id": "PAR-DOC076-0364"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC076-0364"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
