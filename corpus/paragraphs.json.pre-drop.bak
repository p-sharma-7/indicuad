    "paragraph_index": 26,
    "page_start": 5,
    "page_end": 5,
    "char_start": 5808,
    "char_end": 5997,
    "char_count": 189,
    "text": "“Equipment/Materials/Goods” means and include all equipment, machinery, stores,\ngoods which are required under the Contract for satisfactory performance of Services by\nthe Service Provider.",
    "is_boilerplate": true,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC066-0027",
