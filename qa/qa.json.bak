  {
    "qa_id": "IND-Q-02044",
    "doc_id": "DOC-070",
    "category_id": "CAT-020",
    "question": "Highlight the parts (if any) of this contract related to \"Liquidated Damages\". Details: Are liquidated damages, penalties, or a termination fee payable on breach or delay?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC070-CAT020",
    "answers": [
      {
        "text": "If the Contractor fails to maintain the required progress in terms of clause 72.4 or relevant\nclause of Additional Conditions of Contract, to complete the work and clear the Site on or before\nthe completion date or extended date of completion, he shall, without prejudice to any other right\nor remedy available under the law to EPI on account of such breach, pay as agreed\ncompensation the amount calculated at the rates stipulated below or such smaller amount as\nthe Engineer in charge (whose decision in writing shall be final and binding) may decide on the\namount of tendered value of the work for every completed day / week (as applicable) that the\nprogress remains below that specified in Clause 72.4.1 or the relevant clause in Additional\nConditions of Contract or that the work remains incomplete. This will also apply to items or\ngroup of items for which a separate period of completion has been specified.\ni) For works with completion period not exceeding 3 month (as originally stipulated) @ 1% per\nday\nii) For works with completion period exceeding 3 months (as originally stipulated) @ 1% per\nweek or part thereof\nProvided always that the total amount of compensation for delay to be paid under this Condition\nshall not exceed 10% of the Tendered Value of work or of the Tendered Value of the item or\ngroup of items of work for which a separate period of completion is originally given.",
        "answer_start": 23490,
        "answer_end": 24888,
        "paragraph_id": "PAR-DOC070-0065"
      }
    ],
    "is_impossible": false,
    "gold_paragraph_ids": [
      "PAR-DOC070-0065"
    ],
    "doc_origin": "collected_real",
    "tier": "A",
    "split": "core",
    "annotator_ids": [
      "Pushkar SHarma, lead of project"
    ],
    "annotation_pass": "P1-model-assisted",
    "model_assisted": true,
    "adjudicated": false,
    "jaccard_agreement": null,
    "annotator_notes": ""
  },
