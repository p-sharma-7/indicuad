  {
    "qa_id": "IND-Q-00937",
    "doc_id": "DOC-048",
    "category_id": "CAT-012",
    "question": "Highlight the parts (if any) of this contract related to \"IP Ownership Assignment\". Details: Does intellectual property created under this contract vest in or get assigned to one of the parties?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC048-CAT012",
    "answers": [
      {
        "text": "To the extent that any rights referred to under Clause 3.1 do not vest with the Company automatically\nas per the terms above or through operation of law, the Employee hereby irrevocably and in perpetuity\nassigns to the Company all of right, title and interest (including without limitation any and all Intellectual\nProperty Rights),  that is now or may be available, in: (a) any and all Company Intellectual Property; and\n(b) any and all Proprietary Information that the Employee may  have conceived, created, improved\nupon, developed or contributed to prior to the Effective Date, as part of his association with,\ncontribution to the Company or its incorporation (including as part of work undertaken for the business\nof the Company prior to its incorporation).",
        "answer_start": 11813,
        "answer_end": 12575,
        "paragraph_id": "PAR-DOC048-0031"
      },
      {
        "text": "The Company shall retain all rights, title and interest and Intellectual Property Rights in any Company\nIntellectual Property created, conceived, developed, contributed to or improved upon by the Employee\nduring the course of his Employment, shall vest with the Company upon such creation, conception,\ndevelopment, contribution or improvement.",
        "answer_start": 10643,
        "answer_end": 10986,
        "paragraph_id": "PAR-DOC048-0028"
      }
