    "page_end": 85,
    "char_start": 203075,
    "char_end": 203313,
    "char_count": 238,
    "text": "(b) Upon occurrence of a Force Majeure Event after the Date of Award of Concession, the costs\nincurred and attributable to such event and directly relating to the Project (the “Force Majeure\nCosts”) shall be allocated and paid as follows:",
    "is_boilerplate": false,
    "is_superseded": false
  },
