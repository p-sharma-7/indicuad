  {
    "qa_id": "IND-Q-02326",
    "doc_id": "DOC-074",
    "category_id": "CAT-017",
    "question": "Highlight the parts (if any) of this contract related to \"Payment Terms & Schedule\". Details: What are the payment amounts, milestones, and due dates?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC074-CAT017",
    "answers": [
      {
        "text": "Each Monthly Bill shall include all charges as per this Agreement for the energy\nsupplied for the relevant Month based on Energy Accounts issued by RPC or any\nother competent authority which shall be binding on both the Parties. The Monthly\nBill amount shall be the product of the energy as per Energy Accounts and the\nApplicable Tariff. Energy drawn from the grid will be regulated as per the applicable\nCentral/State regulations.",
        "answer_start": 75911,
        "answer_end": 76342,
        "paragraph_id": "PAR-DOC074-0133"
      },
      {
        "text": "For payment of any Bill on or before Due Date, the following Rebate shall be paid by\nthe SPD to NTPC in the following manner.",
        "answer_start": 78439,
        "answer_end": 78564,
        "paragraph_id": "PAR-DOC074-0142"
      }
    ],
