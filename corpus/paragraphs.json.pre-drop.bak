  },
  {
    "paragraph_id": "PAR-DOC086-0254",
    "doc_id": "DOC-086",
    "paragraph_index": 254,
    "page_start": 64,
    "page_end": 64,
    "char_start": 148774,
    "char_end": 150014,
    "char_count": 1240,
    "text": "ARTICLE 15: ENTRY INTO COMMERCIAL SERVICE\n15.1\nCommercial Operation Date (COD)\nXXX Ropeway or part thereof shall be deemed to be complete when the Completion Certificate\nor the Provisional Certificate, as the case may be, is issued under the provisions of Article 14,\nand accordingly the commercial operation date of the Project shall be the date on which such\nCompletion Certificate or the Provisional Certificate is issued] 9 (the “COD”). The XXX\nRopeway shall enter into commercial service on COD whereupon the Concessionaire shall be\nentitled to demand and collect Fee in accordance with the provisions of Article 28,provided,\nhowever, that the entry of XXX Ropeway or part thereof into commercial service shall always\nbe subject to compliance with the provisions of Clause 18.3.\n15.2\nDamages for delay\nSubject to the provisions of Clause 12.3, if COD does not occur prior to the 91st (ninety first)\nday after the Scheduled Date, unless the delay is on account of reasons solely attributable to the\nAuthority or due to Force Majeure, the Concessionaire shall pay Damages to the Authority in\na sum calculated at the rate of 0.1% (zero point one per cent) of the amount of Performance\nSecurity for delay of each day until COD is achieved.",
    "is_boilerplate": false,
    "is_superseded": false
  },
  {
    "paragraph_id": "PAR-DOC086-0255",
    "doc_id": "DOC-086",
    "paragraph_index": 255,
    "page_start": 64,
    "page_end": 64,
    "char_start": 150016,
    "char_end": 150193,
    "char_count": 177,
    "text": "9 This provision may be suitably modified in case of a project where Fee is being levied and collected prior to the\nAppointed Date. In such a case, clause 15.2 shall be omitted.",
    "is_boilerplate": false,
    "is_superseded": false
  },
