  {
    "qa_id": "IND-Q-02749",
    "doc_id": "DOC-085",
    "category_id": "CAT-012",
    "question": "Highlight the parts (if any) of this contract related to \"IP Ownership Assignment\". Details: Does intellectual property created under this contract vest in or get assigned to one of the parties?",
    "question_register": "canonical",
    "intent_group_id": "IG-DOC085-CAT012",
    "answers": [
      {
        "text": "The Purchaser shall own and have a right in perpetuity to use all newly created\nIntellectual Property Rights which have solely arisen out of or have been developed\nsolely during execution of this Agreement, including but not limited to all processes,\nproducts, specifications, reports, drawings and other documents which have been\nnewly created and developed by the Managed Service Provider solely during the\nperformance of the Services. The Managed Service Provider undertakes to disclose all\nsuch Intellectual Property Rights arising in performance of the Services to the Purchaser\nand execute all such agreements/documents and file all relevant applications, effect",
        "answer_start": 87776,
        "answer_end": 88444,
        "paragraph_id": "PAR-DOC085-0146"
      }
