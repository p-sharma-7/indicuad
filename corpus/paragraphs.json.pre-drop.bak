    "page_end": 52,
    "char_start": 115978,
    "char_end": 116180,
    "char_count": 202,
    "text": "2. Generic\nBidder financial standing: The bidder should not be under liquidation, court receivership or similar\nproceedings, should not be bankrupt. Bidder to upload undertaking to this effect with bid.",
    "is_boilerplate": false,
    "is_superseded": false
  },
