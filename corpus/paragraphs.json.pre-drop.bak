    "page_end": 33,
    "char_start": 80607,
    "char_end": 80727,
    "char_count": 120,
    "text": "46.2 Unless terminated by OWNER/CONSULTANT, CONTRACT shall remain  valid\ntill obligations of both parties are fulfilled.",
